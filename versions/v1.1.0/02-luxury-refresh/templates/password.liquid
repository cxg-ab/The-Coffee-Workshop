{%- comment -%}
  Plain default password page — no Coming Soon design here. That work
  lives on its own dedicated theme ("The Coffee Workshop - Coming Soon
  Only").
{%- endcomment -%}
<div style="min-height:60vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:4rem 1.5rem;">
  <div>
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="max-height:3rem;width:auto;margin-bottom:1.5rem;">
    {%- endif -%}
    <p style="font-size:0.9rem;color:#6b6b6b;">{{ shop.name }}</p>
  </div>
</div>
