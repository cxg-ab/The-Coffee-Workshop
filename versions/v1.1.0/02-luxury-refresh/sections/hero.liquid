<section class="hero-section relative overflow-hidden bg-white text-[#1C1917]" data-hero-section>
  <div class="hero-clip" data-hero-clip>
    {% render 'hero-arabic-bg' %}

    <div class="site-container relative z-10 grid items-center gap-4 py-4 lg:grid-cols-2 lg:gap-8 lg:py-6">
    <div class="hero-copy relative z-20 max-w-xl" data-hero-copy>
      {%- if settings.brand_tagline != blank -%}
        <p class="hero-tagline mb-3" data-hero-tagline>{{ settings.brand_tagline }}</p>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="section-eyebrow hero-eyebrow mb-4" data-hero-eyebrow>
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      <div class="hero-brand-rule" aria-hidden="true"></div>

      <h1 class="hero-heading" data-hero-heading>
        {%- capture arabic_word_with_style -%}<br><span style="font-family: 'Noto Kufi Arabic', sans-serif;">ماستر</span><br>{%- endcapture -%}
        {%- assign processed_heading = section.settings.heading | replace: 'ماستر', arabic_word_with_style -%}
        {%- assign heading_lines = processed_heading | split: '<br>' -%}
        {%- for line in heading_lines -%}
          {%- assign trimmed = line | strip -%}
          {%- if trimmed != blank -%}
            <span class="hero-heading__line" data-hero-heading-line style="display: block;">
              <span class="hero-heading__inner">{{ trimmed }}</span>
            </span>
          {%- endif -%}
        {%- endfor -%}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="hero-lead prose-brand" data-hero-sub>
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}

      <div class="hero-cta flex flex-wrap gap-3 lg:gap-4" data-hero-cta>
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_link | default: routes.all_products_collection_url }}" class="btn-primary">
            {{ section.settings.cta_primary_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a href="{{ section.settings.cta_secondary_link | default: '#visit-workshop' }}" class="btn-outline">
            {{ section.settings.cta_secondary_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.show_trust_line -%}
        <p class="hero-trust-line" data-hero-trust>
          {%- if section.settings.trust_line != blank -%}
            {{ section.settings.trust_line }}
          {%- else -%}
            {{ 'home.hero.trust' | t }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    <div class="hero-3d-stage relative z-10 flex min-h-[140px] w-full shrink-0 items-center justify-center sm:min-h-[180px]" data-hero-3d>
      <div class="hero-orb absolute h-40 w-40 rounded-full bg-brand/25 blur-3xl" data-hero-orb></div>
      <div class="hero-orb absolute h-28 w-28 rounded-full bg-brand-light/35 blur-2xl" data-hero-orb></div>
      <div class="hero-orb absolute h-20 w-20 rounded-full bg-brand/15 blur-xl" data-hero-orb></div>

      <div
        class="hero-visual relative z-10 flex items-center justify-center rounded-full border border-line bg-surface shadow-brand"
        data-hero-visual
      >
        {%- if section.settings.hero_image != blank -%}
          {{
            section.settings.hero_image
            | image_url: width: 800
            | image_tag:
              class: 'h-full w-full rounded-full object-cover',
              loading: 'eager',
              alt: section.settings.heading
          }}
        {%- elsif settings.logo != blank -%}
          {{
            settings.logo
            | image_url: width: 400
            | image_tag:
              class: 'h-auto max-h-48 w-auto px-8',
              loading: 'eager',
              alt: shop.name
          }}
        {%- else -%}
          <span class="font-display text-center text-sm font-bold uppercase tracking-[0.2em] text-brand">
            {{ settings.brand_tagline | default: 'Specialty Coffee' }}
          </span>
        {%- endif -%}
      </div>
    </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Est. 2018 · Ras Al Khaimah, UAE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Small batches. Master roasted."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We discover, sample, and reserve micro-lot Arabica — roasted in small batches in Ras Al Khaimah for home brewers and advanced enthusiasts."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary button label",
      "default": "Shop beans"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary button label",
      "default": "Visit us"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Secondary button link",
      "info": "Defaults to the Visit us section on the homepage."
    },
    {
      "type": "checkbox",
      "id": "show_trust_line",
      "label": "Show trust line under buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line (optional override)",
      "info": "Leave blank to use the default locale string."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image (optional)",
      "info": "Square or portrait image — displayed inside the circle."
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
