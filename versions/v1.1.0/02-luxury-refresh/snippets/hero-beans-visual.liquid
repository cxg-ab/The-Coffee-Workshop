{%- comment -%}
  Hero coffee beans — big coloured beans with optional photo on center bean.
  Requires bean-clip-svg snippet once per page.
{%- endcomment -%}

{% render 'bean-clip-svg' %}

<div class="hero-beans-stage relative mx-auto h-[280px] w-full max-w-md sm:h-[360px] lg:h-[420px]" data-hero-beans aria-hidden="true">
  {%- comment -%} Back bean — dark roast {%- endcomment -%}
  <div class="hero-bean hero-bean--back bean-shape" data-hero-bean data-hero-bean-depth="0.4">
    <div class="hero-bean__fill hero-bean__fill--dark"></div>
    <div class="hero-bean__shine"></div>
  </div>

  {%- comment -%} Center bean — main (image or brand gradient) {%- endcomment -%}
  <div class="hero-bean hero-bean--center bean-shape" data-hero-bean data-hero-bean-depth="1" data-hero-visual>
    {%- if hero_image != blank -%}
      {{
        hero_image
        | image_url: width: 900
        | image_tag:
          class: 'hero-bean__photo bean-shape',
          loading: 'eager',
          widths: '400, 600, 900',
          sizes: '(max-width: 640px) 220px, 280px',
          alt: hero_alt
      }}
    {%- elsif logo != blank -%}
      <div class="hero-bean__logo-wrap">
        {{
          logo
          | image_url: width: 320
          | image_tag:
            class: 'hero-bean__logo',
            loading: 'eager',
            alt: hero_alt
        }}
      </div>
    {%- else -%}
      <div class="hero-bean__fill hero-bean__fill--main"></div>
    {%- endif -%}
    <div class="hero-bean__shine"></div>
    <div class="hero-bean__crease"></div>
  </div>

  {%- comment -%} Front bean — gold accent {%- endcomment -%}
  <div class="hero-bean hero-bean--front bean-shape" data-hero-bean data-hero-bean-depth="0.7">
    <div class="hero-bean__fill hero-bean__fill--gold"></div>
    <div class="hero-bean__shine"></div>
  </div>
</div>
