{%- comment -%}
  Coffee Bean Roast — HD WebP scroll sequence.
  Bean phase: centered. Pack phase: bottom-anchored, top half visible, bottom cropped.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign count = section.settings.frame_count -%}
{%- assign mobile_scrub_vh = section.settings.scrub_vh | times: 0.5 | round -%}

<style>
  #beanRoast-{{ sid }}{
    --scrub-vh: {{ section.settings.scrub_vh }};
    --bean-w: {{ section.settings.bean_width }}%;
    --bean-h: {{ section.settings.bean_height }}vh;
    --bean-max-w: {{ section.settings.bean_max_width }}px;
    --bean-max-h: {{ section.settings.bean_max_height }}px;
    --pack-h: {{ section.settings.pack_viewport_height }}vh;
    --pack-bottom: {{ section.settings.pack_bottom_offset }}vh;
  }
  @media (max-width: 768px) {
    #beanRoast-{{ sid }} { --scrub-vh: {{ mobile_scrub_vh }}; }
  }
  #beanRoast-{{ sid }} .br-track{position:relative;height:calc(var(--scrub-vh) * 1vh)}
  #beanRoast-{{ sid }} .br-stage{
    position:sticky;top:0;height:100vh;
    display:flex;align-items:center;justify-content:center;
    overflow:hidden;
  }
  #beanRoast-{{ sid }} .br-stage.is-pack{
    align-items:flex-end;
    justify-content:center;
    padding-bottom:var(--pack-bottom);
  }
  #beanRoast-{{ sid }} .br-head{
    position:absolute;left:0;right:0;top:8vh;text-align:center;padding:0 24px;
    pointer-events:none;z-index:2;
  }
  #beanRoast-{{ sid }} .br-view{
    position:relative;
    width:min(var(--bean-w), var(--bean-max-w), 96vw);
    height:min(var(--bean-h), var(--bean-max-h), 82vh);
    flex:0 0 auto;
    overflow:hidden;
    border:none;outline:none;box-shadow:none;background:transparent;
    transition:height .35s ease, width .35s ease;
  }
  #beanRoast-{{ sid }} .br-stage.is-pack .br-view{
    height:min(var(--pack-h), 58vh);
    width:min(var(--bean-w), var(--bean-max-w), 92vw);
    margin-bottom:0;
  }
  #beanRoast-{{ sid }} .br-canvas{
    width:100%;height:100%;display:block;
    background:transparent;border:none;outline:none;box-shadow:none;
  }
  #beanRoast-{{ sid }} .br-loader{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    pointer-events:none;
  }
  #beanRoast-{{ sid }} .br-caption{
    position:absolute;left:0;right:0;bottom:7vh;text-align:center;
    font-size:.75rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;
    color:rgba(28,25,23,.55);pointer-events:none;z-index:2;
  }
  #beanRoast-{{ sid }} .br-stage.is-pack .br-caption{bottom:calc(var(--pack-h) + var(--pack-bottom) + 2vh)}
  @media (prefers-reduced-motion: reduce){
    #beanRoast-{{ sid }} .br-track{height:auto}
    #beanRoast-{{ sid }} .br-stage{position:static;height:auto;padding:14vh 0}
    #beanRoast-{{ sid }} .br-view{transition:none}
  }
</style>

<section id="beanRoast-{{ sid }}" class="coffee-bean-roast bg-[#E6D095]">
  <div class="br-track" data-br-track>
    <div class="br-stage" data-br-stage>
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="br-head">
        {% if section.settings.heading != blank %}<h2 class="font-display font-bold text-4xl lg:text-6xl text-ink leading-[1.05] tracking-tight">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.subheading != blank %}<p class="prose-brand mt-4">{{ section.settings.subheading }}</p>{% endif %}
      </div>
      {%- endif -%}

      <div class="br-view" data-br-view>
        <canvas class="br-canvas" data-br-canvas aria-hidden="true"></canvas>
        <div class="br-loader text-brand font-semibold tracking-widest text-xs uppercase opacity-50" data-br-loader>Loading 0%</div>
      </div>

      {% if section.settings.show_caption %}
        <div class="br-caption" data-br-caption>Green</div>
      {% endif %}
    </div>
  </div>
</section>

<script>
(function(){
  var frames = [
  {%- if section.settings.frame_source == 'assets' -%}
    {%- for i in (1..count) -%}
      {%- capture p -%}{%- if i < 10 -%}00{{ i }}{%- elsif i < 100 -%}0{{ i }}{%- else -%}{{ i }}{%- endif -%}{%- endcapture -%}
      {%- capture fname -%}bean_{{ p }}.webp{%- endcapture -%}
      "{{ fname | asset_url }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  {%- else -%}
    {%- assign base = section.settings.custom_base | strip -%}
    {%- for i in (1..count) -%}
      {%- capture p -%}{%- if i < 10 -%}00{{ i }}{%- elsif i < 100 -%}0{{ i }}{%- else -%}{{ i }}{%- endif -%}{%- endcapture -%}
      "{{ base }}bean_{{ p }}.webp"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  {%- endif -%}
  ];

  var cfg = {
    root: document.getElementById('beanRoast-{{ sid }}'),
    frames: frames,
    captions: {{ section.settings.captions_json }},
    packStart: {{ section.settings.pack_start }} / 100,
    packVisible: {{ section.settings.pack_visible }} / 100,
    packScale: {{ section.settings.pack_scale }} / 100
  };

  if(!window.__beanRoastClean){
    window.__beanRoastClean = function(cfg){
      var root = cfg.root;
      if(!root) return;

      var track = root.querySelector('[data-br-track]');
      var stage = root.querySelector('[data-br-stage]');
      var view = root.querySelector('[data-br-view]');
      var cap = root.querySelector('[data-br-caption]');
      var load = root.querySelector('[data-br-loader]');
      var cv = root.querySelector('[data-br-canvas]');
      var ctx = cv.getContext('2d', { alpha: true });

      var N = cfg.frames.length;
      var imgs = new Array(N);
      var done = 0;
      var ready = false;
      var cur = -1;
      var pending = false;
      var lastPack = null;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      ctx.imageSmoothingEnabled = true;
      if('imageSmoothingQuality' in ctx) ctx.imageSmoothingQuality = 'high';

      function clamp(v){ return v < 0 ? 0 : (v > 1 ? 1 : v); }
      function ease(t){ return t < .5 ? 2*t*t : 1 - Math.pow(-2*t + 2, 2) / 2; }
      function prog(){
        var r = track.getBoundingClientRect();
        var tot = r.height - innerHeight;
        return tot <= 0 ? 0 : clamp(-r.top / tot);
      }
      function capFor(p){
        var c = cfg.captions.length ? cfg.captions[0][1] : '';
        for(var i = 0; i < cfg.captions.length; i++){
          if(p >= cfg.captions[i][0]) c = cfg.captions[i][1];
        }
        return c;
      }

      function size(){
        var dpr = Math.min(devicePixelRatio || 1, 3);
        var r = cv.getBoundingClientRect();
        cv.width = Math.max(1, Math.round(r.width * dpr));
        cv.height = Math.max(1, Math.round(r.height * dpr));
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        if(ready) paint(cur < 0 ? 0 : cur, true, lastProg);
      }

      var lastProg = 0;

      function paint(idx, force, p){
        if(idx === cur && !force) return;
        var im = imgs[idx];
        if(!im || !im.complete || !im.naturalWidth) return;
        cur = idx;
        lastProg = p;

        var r = cv.getBoundingClientRect();
        var cw = r.width;
        var ch = r.height;
        var iw = im.naturalWidth;
        var ih = im.naturalHeight;
        var inPack = p >= cfg.packStart;
        var scale, dw, dh, dx, dy;

        if(!inPack){
          scale = Math.min(cw / iw, ch / ih);
          dw = iw * scale;
          dh = ih * scale;
          dx = (cw - dw) * 0.5;
          dy = (ch - dh) * 0.5;
        } else {
          /* Pack pinned to bottom: show top portion, crop lower half below viewport */
          var vis = Math.max(0.35, cfg.packVisible);
          var extra = cfg.packScale;
          scale = Math.max(cw / iw, (ch / vis) / ih) * extra;
          dw = iw * scale;
          dh = ih * scale;
          dx = (cw - dw) * 0.5;
          dy = ch - dh;
        }

        ctx.clearRect(0, 0, cw, ch);
        ctx.drawImage(im, dx, dy, dw, dh);
      }

      function render(){
        pending = false;
        var p = reduce ? 1 : prog();
        var inPack = p >= cfg.packStart;

        if(inPack !== lastPack){
          lastPack = inPack;
          stage.classList.toggle('is-pack', inPack);
          requestAnimationFrame(size);
        }

        paint(Math.round(p * (N - 1)), false, p);

        if(cap){
          cap.textContent = capFor(p);
          cap.style.opacity = inPack ? '0' : '1';
        }
      }

      function onScroll(){
        if(pending) return;
        pending = true;
        requestAnimationFrame(render);
      }

      function preload(){
        for(var i = 0; i < N; i++){
          (function(i){
            var im = new Image();
            im.decoding = 'async';
            im.onload = im.onerror = function(){
              done++;
              if(load) load.textContent = 'Loading ' + Math.round(done / N * 100) + '%';
              if(done >= N){
                ready = true;
                if(load) load.style.display = 'none';
                size();
                render();
              }
            };
            im.src = cfg.frames[i];
            imgs[i] = im;
          })(i);
        }
      }

      var io = new IntersectionObserver(function(en){
        if(en[0].isIntersecting){ io.disconnect(); preload(); }
      }, { rootMargin: '600px 0px' });
      io.observe(track);

      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', size);
      size();
    };
  }

  if(document.readyState !== 'loading') window.__beanRoastClean(cfg);
  else document.addEventListener('DOMContentLoaded', function(){ window.__beanRoastClean(cfg); });
})();
</script>

{% schema %}
{
  "name": "Coffee Bean Roast",
  "tag": "section",
  "class": "section-coffee-bean-roast",
  "settings": [
    { "type": "header", "content": "Frames" },
    {
      "type": "select",
      "id": "frame_source",
      "label": "Frame source",
      "options": [
        { "value": "assets", "label": "Theme assets (/assets folder)" },
        { "value": "custom", "label": "Custom URL (Shopify Files / CDN)" }
      ],
      "default": "assets"
    },
    {
      "type": "text",
      "id": "custom_base",
      "label": "Custom base URL",
      "default": "https://your-cdn.com/bean-frames/"
    },
    {
      "type": "number",
      "id": "frame_count",
      "label": "Frame count",
      "default": 241
    },
    { "type": "header", "content": "Bean phase (display)" },
    {
      "type": "range",
      "id": "bean_width",
      "label": "Width",
      "min": 40,
      "max": 100,
      "step": 1,
      "default": 78,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bean_height",
      "label": "Height",
      "min": 40,
      "max": 95,
      "step": 1,
      "default": 72,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "bean_max_width",
      "label": "Max width",
      "min": 400,
      "max": 1600,
      "step": 20,
      "default": 1200,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "bean_max_height",
      "label": "Max height",
      "min": 400,
      "max": 1200,
      "step": 20,
      "default": 1000,
      "unit": "px"
    },
    { "type": "header", "content": "Pack phase (bottom crop)" },
    {
      "type": "range",
      "id": "pack_start",
      "label": "Pack phase starts (% scroll)",
      "min": 35,
      "max": 65,
      "step": 1,
      "default": 50,
      "unit": "%",
      "info": "When bag appears; pack pins to bottom from here."
    },
    {
      "type": "range",
      "id": "pack_viewport_height",
      "label": "Pack window height",
      "min": 28,
      "max": 70,
      "step": 1,
      "default": 48,
      "unit": "vh",
      "info": "Visible area — lower half of pack is cropped below."
    },
    {
      "type": "range",
      "id": "pack_visible",
      "label": "Pack height shown",
      "min": 40,
      "max": 70,
      "step": 1,
      "default": 52,
      "unit": "%",
      "info": "Top portion of pack visible; rest hidden below."
    },
    {
      "type": "range",
      "id": "pack_scale",
      "label": "Pack scale",
      "min": 90,
      "max": 130,
      "step": 1,
      "default": 108,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "pack_bottom_offset",
      "label": "Pack distance from bottom",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "unit": "vh"
    },
    { "type": "header", "content": "Motion" },
    {
      "type": "range",
      "id": "scrub_vh",
      "label": "Scroll length",
      "min": 120,
      "max": 600,
      "step": 10,
      "default": 400,
      "unit": "vh"
    },
    { "type": "checkbox", "id": "show_caption", "label": "Show stage label", "default": true },
    {
      "type": "textarea",
      "id": "captions_json",
      "label": "Stage labels",
      "default": "[[0,\"Green\"],[0.30,\"Drying\"],[0.55,\"First Crack\"],[0.80,\"Developing\"],[0.92,\"Roasted\"]]"
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Roasted to order" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Watch it develop as you scroll" }
  ],
  "presets": [{ "name": "Coffee Bean Roast" }]
}
{% endschema %}
