{%- comment -%}
  Coffee Bean Roast — scroll scrub frames (bean_001..bean_N).
  Stop frame setting chooses last frame shown during scroll.
  Final scroll phase can reveal products from a chosen collection.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign total_frames = section.settings.frame_count -%}
{%- assign mobile_scrub_vh = section.settings.scrub_vh | times: 0.5 | round -%}
{%- assign featured_collection = section.settings.collection -%}
{%- assign has_products = false -%}
{%- if featured_collection != blank and featured_collection.products_count > 0 -%}
  {%- assign has_products = true -%}
{%- endif -%}

<style>
  #beanRoast-{{ sid }}{
    --scrub-vh: {{ section.settings.scrub_vh }};
    --bean-w: {{ section.settings.bean_width }}%;
    --bean-h: {{ section.settings.bean_height }}vh;
    --bean-max-w: {{ section.settings.bean_max_width }}px;
    --bean-max-h: {{ section.settings.bean_max_height }}px;
  }
  @media (max-width: 768px) {
    #beanRoast-{{ sid }} { --scrub-vh: {{ mobile_scrub_vh }}; }
    #beanRoast-{{ sid }} .br-stage{
      align-items:center;
      justify-content:center;
      padding:11vh 0 9vh;
    }
    #beanRoast-{{ sid }} .br-head{
      top:4vh;
      padding:0 16px;
    }
    #beanRoast-{{ sid }} .br-view{
      width:min(82vw, var(--bean-w), 96vw);
      height:min(68vh, var(--bean-h), 72vh);
      margin:0 auto;
      flex:0 0 auto;
    }
    #beanRoast-{{ sid }} .br-caption{
      bottom:5vh;
    }
  }
  #beanRoast-{{ sid }} .br-track{position:relative;height:calc(var(--scrub-vh) * 1vh)}
  #beanRoast-{{ sid }} .br-stage{
    position:sticky;top:0;height:100vh;
    display:flex;align-items:flex-end;justify-content:center;
    overflow:hidden;
  }
  #beanRoast-{{ sid }} .br-head{
    position:absolute;left:0;right:0;top:8vh;text-align:center;padding:0 24px;
    pointer-events:none;z-index:4;
  }
  #beanRoast-{{ sid }} .br-view{
    position:relative;z-index:2;
    width:min(var(--bean-w), var(--bean-max-w), 96vw);
    height:min(var(--bean-h), var(--bean-max-h), 90vh);
    flex:0 0 auto;
    border:none;outline:none;box-shadow:none;background:transparent;
  }
  #beanRoast-{{ sid }} .br-canvas{
    width:100%;height:100%;display:block;
    background:transparent;border:none;outline:none;box-shadow:none;
    filter:none;
  }
  #beanRoast-{{ sid }} .br-loader{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    pointer-events:none;
  }
  #beanRoast-{{ sid }} .br-caption{
    position:absolute;left:0;right:0;bottom:7vh;text-align:center;
    font-size:.75rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;
    color:rgba(28,25,23,.55);pointer-events:none;z-index:4;
  }
  #beanRoast-{{ sid }} .br-bean-layer{
    position:relative;z-index:2;display:flex;align-items:flex-end;justify-content:center;
    width:100%;height:100%;will-change:opacity;
  }
  #beanRoast-{{ sid }} .br-products{
    position:absolute;inset:0;z-index:5;display:flex;align-items:center;justify-content:center;
    padding:10vh 0 6vh;opacity:0;pointer-events:none;will-change:opacity;
  }
  #beanRoast-{{ sid }} .br-products.is-active{pointer-events:auto}
  #beanRoast-{{ sid }} .br-products-inner{width:100%;max-width:1280px;padding:0 16px}
  #beanRoast-{{ sid }} .br-products-head{
    display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;
    margin-bottom:1.25rem;
  }
  #beanRoast-{{ sid }} .br-products-grid{
    display:grid;gap:1rem;
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
  @media (min-width: 1024px) {
    #beanRoast-{{ sid }} .br-products{padding:12vh 0 8vh}
    #beanRoast-{{ sid }} .br-products-inner{padding:0 24px}
    #beanRoast-{{ sid }} .br-products-head{margin-bottom:1.75rem}
    #beanRoast-{{ sid }} .br-products-grid{
      gap:1.5rem;
      grid-template-columns:repeat({{ section.settings.product_limit }},minmax(0,1fr));
    }
    #beanRoast-{{ sid }} .br-products .product-card > a{aspect-ratio:4/3}
    #beanRoast-{{ sid }} .br-products .product-card > div:last-child{padding:1rem 1.25rem}
    #beanRoast-{{ sid }} .br-products .product-card .font-display{font-size:1rem}
  }
  @media (max-width: 768px) {
    #beanRoast-{{ sid }} .br-bean-layer{align-items:center}
    #beanRoast-{{ sid }} .br-products{
      align-items:flex-end;padding:8vh 0 5vh;
    }
    #beanRoast-{{ sid }} .br-products-grid{
      display:flex;overflow-x:auto;scroll-snap-type:x mandatory;
      gap:.75rem;padding-bottom:.5rem;-webkit-overflow-scrolling:touch;
    }
    #beanRoast-{{ sid }} .br-products-grid > *{
      flex:0 0 min(72vw,280px);scroll-snap-align:start;
    }
  }
  @media (prefers-reduced-motion: reduce){
    #beanRoast-{{ sid }} .br-track{height:auto}
    #beanRoast-{{ sid }} .br-stage{position:static;height:auto;padding:14vh 0}
    #beanRoast-{{ sid }} .br-products{position:static;opacity:1;pointer-events:auto;padding:2rem 0 0}
    #beanRoast-{{ sid }} .br-bean-layer{display:none}
  }
</style>

<section id="beanRoast-{{ sid }}" class="coffee-bean-roast bg-[#E6D095]">
  <div class="br-track" data-br-track>
    <div class="br-stage" data-br-stage>
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="br-head" data-br-head>
        {% if section.settings.heading != blank %}<h2 class="font-display font-bold text-4xl lg:text-6xl text-ink leading-[1.05] tracking-tight">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.subheading != blank %}<p class="prose-brand mt-4">{{ section.settings.subheading }}</p>{% endif %}
      </div>
      {%- endif -%}

      <div class="br-bean-layer" data-br-bean-layer>
        <div class="br-view" data-br-view>
          <canvas class="br-canvas" data-br-canvas aria-hidden="true"></canvas>
          <div class="br-loader text-brand font-semibold tracking-widest text-xs uppercase opacity-50" data-br-loader>Loading 0%</div>
        </div>

        {% if section.settings.show_caption %}
          <div class="br-caption" data-br-caption>Green</div>
        {% endif %}
      </div>

      {%- if has_products -%}
      <div class="br-products" data-br-products aria-hidden="true">
        <div class="br-products-inner">
          <div class="br-products-head">
            <div>
              {%- if section.settings.products_heading != blank -%}
                <h3 class="font-display font-bold text-2xl lg:text-4xl text-ink leading-tight tracking-tight">{{ section.settings.products_heading }}</h3>
              {%- endif -%}
              {%- if section.settings.products_subheading != blank -%}
                <p class="prose-brand mt-2 text-sm lg:text-base">{{ section.settings.products_subheading }}</p>
              {%- endif -%}
            </div>
            {%- if section.settings.products_cta_label != blank -%}
              <a href="{{ featured_collection.url }}" class="hidden sm:inline-flex shrink-0 text-xs font-bold uppercase tracking-[0.15em] text-brand border-b border-brand/40 pb-0.5 hover:text-ink transition-colors">
                {{ section.settings.products_cta_label }}
              </a>
            {%- endif -%}
          </div>
          <div class="br-products-grid">
            {%- for product in featured_collection.products limit: section.settings.product_limit -%}
              {% render 'product-card', card_product: product %}
            {%- endfor -%}
          </div>
          {%- if section.settings.products_cta_label != blank -%}
            <a href="{{ featured_collection.url }}" class="sm:hidden mt-4 inline-flex text-xs font-bold uppercase tracking-[0.15em] text-brand">
              {{ section.settings.products_cta_label }} →
            </a>
          {%- endif -%}
        </div>
      </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function(){
  var frames = [
  {%- if section.settings.frame_source == 'assets' -%}
    {%- for i in (1..total_frames) -%}
      {%- capture p -%}{%- if i < 10 -%}00{{ i }}{%- elsif i < 100 -%}0{{ i }}{%- else -%}{{ i }}{%- endif -%}{%- endcapture -%}
      {%- capture fname -%}bean_{{ p }}.webp{%- endcapture -%}
      "{{ fname | asset_url }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  {%- else -%}
    {%- assign base = section.settings.custom_base | strip -%}
    {%- for i in (1..total_frames) -%}
      {%- capture p -%}{%- if i < 10 -%}00{{ i }}{%- elsif i < 100 -%}0{{ i }}{%- else -%}{{ i }}{%- endif -%}{%- endcapture -%}
      "{{ base }}bean_{{ p }}.webp"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  {%- endif -%}
  ];

  var cfg = {
    root: document.getElementById('beanRoast-{{ sid }}'),
    frames: frames,
    captions: {{ section.settings.captions_json }},
    frameStop: {{ section.settings.frame_stop }},
    revealStart: {{ section.settings.reveal_start }} / 100,
    hasProducts: {{ has_products | json }}
  };

  if(!window.__beanRoastClean){
    window.__beanRoastClean = function(cfg){
      var root = cfg.root;
      if(!root) return;

      var track = root.querySelector('[data-br-track]');
      var cap = root.querySelector('[data-br-caption]');
      var load = root.querySelector('[data-br-loader]');
      var cv = root.querySelector('[data-br-canvas]');
      var ctx = cv.getContext('2d', { alpha: true });
      var head = root.querySelector('[data-br-head]');
      var beanLayer = root.querySelector('[data-br-bean-layer]');
      var products = root.querySelector('[data-br-products]');
      var revealStart = cfg.hasProducts ? Math.min(0.95, Math.max(0.5, cfg.revealStart || 0.82)) : 1;

      var N = cfg.frames.length;
      var imgs = new Array(N);
      var done = 0;
      var targetLoads = N;
      var ready = false;
      var cur = -1;
      var pending = false;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var mobileMq = window.matchMedia('(max-width: 768px)');
      var stopIdx = Math.max(0, Math.min(N - 1, cfg.frameStop - 1));

      function isMobile(){ return mobileMq.matches; }

      function loadBudget(){
        if(isMobile()) return Math.min(N, Math.max(stopIdx + 1, 1));
        return N;
      }

      function readyThreshold(){
        var budget = loadBudget();
        if(isMobile()) return Math.min(6, budget);
        return Math.min(12, budget);
      }

      function maxConcurrent(){
        return isMobile() ? 4 : 10;
      }

      function maxDpr(){
        return isMobile() ? 2 : 4;
      }

      ctx.imageSmoothingEnabled = true;
      if('imageSmoothingQuality' in ctx) ctx.imageSmoothingQuality = 'high';

      function clamp(v){ return v < 0 ? 0 : (v > 1 ? 1 : v); }
      function prog(){
        var r = track.getBoundingClientRect();
        var tot = r.height - innerHeight;
        return tot <= 0 ? 0 : clamp(-r.top / tot);
      }
      function capFor(p){
        var c = cfg.captions.length ? cfg.captions[0][1] : '';
        for(var i = 0; i < cfg.captions.length; i++){
          if(p >= cfg.captions[i][0]) c = cfg.captions[i][1];
        }
        return c;
      }
      function roastIndex(p){
        if(stopIdx <= 0) return 0;
        return Math.min(stopIdx, Math.floor(p * (stopIdx + 1)));
      }
      function beanProgress(p){
        if(revealStart >= 1) return p;
        return Math.min(1, p / revealStart);
      }
      function updateReveal(p){
        if(!cfg.hasProducts || revealStart >= 1) return;

        if(p < revealStart){
          if(beanLayer) beanLayer.style.opacity = '1';
          if(head) head.style.opacity = '1';
          if(products){
            products.style.opacity = '0';
            products.classList.remove('is-active');
            products.setAttribute('aria-hidden', 'true');
          }
          return;
        }

        var fadeP = (p - revealStart) / (1 - revealStart);
        if(beanLayer) beanLayer.style.opacity = String(1 - fadeP);
        if(head) head.style.opacity = String(Math.max(0, 1 - fadeP * 1.4));
        if(products){
          products.style.opacity = String(fadeP);
          products.classList.toggle('is-active', fadeP > 0.35);
          products.setAttribute('aria-hidden', fadeP > 0.35 ? 'false' : 'true');
        }
      }

      function size(){
        var dpr = Math.min(devicePixelRatio || 1, maxDpr());
        var r = cv.getBoundingClientRect();
        cv.width = Math.max(1, Math.round(r.width * dpr));
        cv.height = Math.max(1, Math.round(r.height * dpr));
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        if(ready && cur >= 0) paint(cur, true);
      }

      function requestFrame(i){
        if(i < 0 || i >= N || imgs[i]) return;
        var im = new Image();
        im.decoding = 'async';
        im.onload = im.onerror = function(){
          if(ready) paint(roastIndex(beanProgress(prog())), true);
        };
        im.src = cfg.frames[i];
        imgs[i] = im;
      }

      function paint(idx, force){
        if(idx === cur && !force) return;
        var im = imgs[idx];
        if(!im || !im.complete || !im.naturalWidth){
          if(idx <= stopIdx) requestFrame(idx);
          return;
        }
        cur = idx;

        var r = cv.getBoundingClientRect();
        var cw = r.width;
        var ch = r.height;
        var iw = im.naturalWidth;
        var ih = im.naturalHeight;
        var scale = Math.min(cw / iw, ch / ih);
        var dw = iw * scale;
        var dh = ih * scale;
        var dx = (cw - dw) * 0.5;
        var dy = isMobile() ? (ch - dh) * 0.5 : ch - dh;

        ctx.clearRect(0, 0, cw, ch);
        ctx.drawImage(im, dx, dy, dw, dh);
      }

      function render(){
        pending = false;
        var p = reduce ? 1 : prog();
        var beanP = beanProgress(p);

        if(cfg.hasProducts && p >= revealStart){
          paint(stopIdx, false);
          if(cap) cap.textContent = capFor(1);
        } else {
          paint(roastIndex(beanP), false);
          if(cap) cap.textContent = capFor(beanP);
        }

        updateReveal(p);
      }

      function onScroll(){
        if(pending) return;
        pending = true;
        requestAnimationFrame(render);
      }

      function preload(){
        var budget = loadBudget();
        targetLoads = budget;
        var queue = [];
        var seen = {};
        var priority = [0, stopIdx, Math.floor(stopIdx * 0.5), 1, stopIdx - 1];
        priority.forEach(function(i){
          if(i >= 0 && i < budget && !seen[i]){ seen[i] = true; queue.push(i); }
        });
        for(var i = 0; i < budget; i++){
          if(!seen[i]) queue.push(i);
        }

        var active = 0;
        var threshold = readyThreshold();

        function markDone(){
          done++;
          if(load) load.textContent = 'Loading ' + Math.min(100, Math.round(done / targetLoads * 100)) + '%';
          if(!ready && done >= threshold){
            ready = true;
            if(load) load.style.display = 'none';
            size();
            render();
          }
          if(done >= targetLoads && load) load.style.display = 'none';
        }

        function loadAt(i){
          if(imgs[i] || i >= N) return;
          active++;
          var im = new Image();
          im.decoding = 'async';
          im.onload = im.onerror = function(){
            active--;
            markDone();
            pump();
          };
          im.src = cfg.frames[i];
          imgs[i] = im;
        }

        function pump(){
          while(active < maxConcurrent() && queue.length){
            loadAt(queue.shift());
          }
        }

        pump();
      }

      var io = new IntersectionObserver(function(en){
        if(en[0].isIntersecting){ io.disconnect(); preload(); }
      }, { rootMargin: isMobile() ? '120px 0px' : '400px 0px' });
      io.observe(track);

      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', size);
      size();
    };
  }

  if(document.readyState !== 'loading') window.__beanRoastClean(cfg);
  else document.addEventListener('DOMContentLoaded', function(){ window.__beanRoastClean(cfg); });
})();
</script>

{% schema %}
{
  "name": "Coffee Bean Roast",
  "tag": "section",
  "class": "section-coffee-bean-roast",
  "settings": [
    { "type": "header", "content": "Frames" },
    {
      "type": "select",
      "id": "frame_source",
      "label": "Frame source",
      "options": [
        { "value": "assets", "label": "Theme assets (/assets folder)" },
        { "value": "custom", "label": "Custom URL (Shopify Files / CDN)" }
      ],
      "default": "assets"
    },
    {
      "type": "text",
      "id": "custom_base",
      "label": "Custom base URL",
      "default": "https://your-cdn.com/bean-frames/"
    },
    {
      "type": "number",
      "id": "frame_count",
      "label": "Total frames (max)",
      "default": 203,
      "info": "All exported frames in theme assets (bean_001 to bean_N). Current export: 203."
    },
    {
      "type": "number",
      "id": "frame_stop",
      "label": "Stop frames at",
      "default": 158,
      "info": "Last frame to show during scroll (1–203). Recommended: 158."
    },
    { "type": "header", "content": "Bean display" },
    {
      "type": "range",
      "id": "bean_width",
      "label": "Width",
      "min": 40,
      "max": 100,
      "step": 1,
      "default": 78,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bean_height",
      "label": "Height",
      "min": 40,
      "max": 95,
      "step": 1,
      "default": 72,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "bean_max_width",
      "label": "Max width",
      "min": 400,
      "max": 1600,
      "step": 20,
      "default": 1200,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "bean_max_height",
      "label": "Max height",
      "min": 400,
      "max": 1200,
      "step": 20,
      "default": 1000,
      "unit": "px"
    },
    { "type": "header", "content": "Motion" },
    {
      "type": "range",
      "id": "scrub_vh",
      "label": "Scroll length",
      "min": 120,
      "max": 600,
      "step": 10,
      "default": 400,
      "unit": "vh"
    },
    { "type": "checkbox", "id": "show_caption", "label": "Show stage label", "default": true },
    {
      "type": "textarea",
      "id": "captions_json",
      "label": "Stage labels",
      "default": "[[0,\"Green\"],[0.30,\"Drying\"],[0.55,\"First Crack\"],[0.80,\"Developing\"],[0.92,\"Roasted\"]]"
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Roasted to order" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Watch it develop as you scroll" },
    { "type": "header", "content": "Product reveal" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products shown at the end of the roast scroll (e.g. Exotic)."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "reveal_start",
      "label": "Reveal starts at",
      "min": 70,
      "max": 92,
      "step": 1,
      "default": 82,
      "unit": "%",
      "info": "Scroll progress when bean fades out and product cards fade in."
    },
    { "type": "text", "id": "products_heading", "label": "Products heading", "default": "Try something exotic" },
    { "type": "text", "id": "products_subheading", "label": "Products subheading", "default": "Rare micro-lots, roasted to order" },
    { "type": "text", "id": "products_cta_label", "label": "View all label", "default": "View all exotic" }
  ],
  "presets": [{ "name": "Coffee Bean Roast" }]
}
{% endschema %}
