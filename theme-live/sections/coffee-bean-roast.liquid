{%- comment -%}
  Coffee Bean Roast — HD WebP frames (no pack in video).
  Bean phase: centered canvas. Pour phase: coffee falls behind uploaded pack image.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign count = section.settings.frame_count -%}
{%- assign mobile_scrub_vh = section.settings.scrub_vh | times: 0.5 | round -%}
{%- assign has_pack_image = false -%}
{%- if section.settings.pack_image != blank -%}
  {%- assign has_pack_image = true -%}
{%- endif -%}

<style>
  #beanRoast-{{ sid }}{
    --scrub-vh: {{ section.settings.scrub_vh }};
    --bean-w: {{ section.settings.bean_width }}%;
    --bean-h: {{ section.settings.bean_height }}vh;
    --bean-max-w: {{ section.settings.bean_max_width }}px;
    --bean-max-h: {{ section.settings.bean_max_height }}px;
    --pack-w: {{ section.settings.pack_width }}%;
    --pack-max-w: {{ section.settings.pack_max_width }}px;
    --pack-visible: {{ section.settings.pack_visible | divided_by: 100.0 }};
    --pour-h: {{ section.settings.pour_viewport_height }}vh;
    --pour-overlap: {{ section.settings.pour_overlap }}%;
    --pour-fall: {{ section.settings.pour_fall_distance }}%;
  }
  @media (max-width: 768px) {
    #beanRoast-{{ sid }} { --scrub-vh: {{ mobile_scrub_vh }}; }
  }
  #beanRoast-{{ sid }} .br-track{position:relative;height:calc(var(--scrub-vh) * 1vh)}
  #beanRoast-{{ sid }} .br-stage{
    position:sticky;top:0;height:100vh;
    display:flex;align-items:center;justify-content:center;
    overflow:hidden;
  }
  #beanRoast-{{ sid }} .br-head{
    position:absolute;left:0;right:0;top:8vh;text-align:center;padding:0 24px;
    pointer-events:none;z-index:4;
  }
  #beanRoast-{{ sid }} .br-view{
    position:relative;z-index:2;
    width:min(var(--bean-w), var(--bean-max-w), 96vw);
    height:min(var(--bean-h), var(--bean-max-h), 82vh);
    flex:0 0 auto;
    border:none;outline:none;box-shadow:none;background:transparent;
    transition:width .4s ease, height .4s ease, bottom .4s ease;
  }
  #beanRoast-{{ sid }} .br-stage.is-pour .br-view{
    position:absolute;left:50%;
    transform:translateX(-50%) translateY(var(--pour-y, -28%));
    width:min(var(--pack-w), var(--pack-max-w), 88vw);
    height:min(var(--pour-h), 52vh);
    margin:0;
    opacity:0;
    pointer-events:none;
    will-change:transform,opacity;
  }
  #beanRoast-{{ sid }} .br-stage.is-pour.is-pouring .br-view{
    opacity:1;
  }
  #beanRoast-{{ sid }} .br-canvas{
    width:100%;height:100%;display:block;
    background:transparent;border:none;outline:none;box-shadow:none;
  }
  #beanRoast-{{ sid }} .br-loader{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    pointer-events:none;
  }
  #beanRoast-{{ sid }} .br-caption{
    position:absolute;left:0;right:0;bottom:7vh;text-align:center;
    font-size:.75rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;
    color:rgba(28,25,23,.55);pointer-events:none;z-index:4;
  }
  #beanRoast-{{ sid }} .br-pack-outer{
    position:absolute;left:50%;bottom:0;z-index:3;
    width:min(var(--pack-w), var(--pack-max-w), 88vw);
    overflow:hidden;pointer-events:none;
    transform:translateX(-50%);
  }
  #beanRoast-{{ sid }} .br-pack-inner{
    will-change:transform;
    transform:translateY(110%);
  }
  #beanRoast-{{ sid }} .br-pack-inner img{
    width:100%;height:auto;display:block;
    border:none;outline:none;box-shadow:none;background:transparent;
  }
  @media (prefers-reduced-motion: reduce){
    #beanRoast-{{ sid }} .br-track{height:auto}
    #beanRoast-{{ sid }} .br-stage{position:static;height:auto;padding:14vh 0}
    #beanRoast-{{ sid }} .br-view{transition:none}
    #beanRoast-{{ sid }} .br-pack-inner{transform:translateY(15%)}
  }
</style>

<section id="beanRoast-{{ sid }}" class="coffee-bean-roast bg-[#E6D095]">
  <div class="br-track" data-br-track>
    <div class="br-stage" data-br-stage>
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="br-head">
        {% if section.settings.heading != blank %}<h2 class="font-display font-bold text-4xl lg:text-6xl text-ink leading-[1.05] tracking-tight">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.subheading != blank %}<p class="prose-brand mt-4">{{ section.settings.subheading }}</p>{% endif %}
      </div>
      {%- endif -%}

      <div class="br-view" data-br-view>
        <canvas class="br-canvas" data-br-canvas aria-hidden="true"></canvas>
        <div class="br-loader text-brand font-semibold tracking-widest text-xs uppercase opacity-50" data-br-loader>Loading 0%</div>
      </div>

      {%- if section.settings.pack_image != blank -%}
      <div class="br-pack-outer" data-br-pack-outer>
        <div class="br-pack-inner" data-br-pack>
          <img
            src="{{ section.settings.pack_image | image_url: width: 1200 }}"
            alt="{{ section.settings.pack_image.alt | default: 'Coffee pack' | escape }}"
            width="{{ section.settings.pack_image.width }}"
            height="{{ section.settings.pack_image.height }}"
            loading="lazy"
            decoding="async"
          >
        </div>
      </div>
      {%- endif -%}

      {% if section.settings.show_caption %}
        <div class="br-caption" data-br-caption>Green</div>
      {% endif %}
    </div>
  </div>
</section>

{%- assign roast_end = section.settings.bean_roast_end -%}
{%- assign pour_single = section.settings.pour_single_frame -%}

<script>
(function(){
  var frames = [
  {%- if section.settings.frame_source == 'assets' -%}
    {%- for i in (1..roast_end) -%}
      {%- capture p -%}{%- if i < 10 -%}00{{ i }}{%- elsif i < 100 -%}0{{ i }}{%- else -%}{{ i }}{%- endif -%}{%- endcapture -%}
      {%- capture fname -%}bean_{{ p }}.webp{%- endcapture -%}
      "{{ fname | asset_url }}",
    {%- endfor -%}
    {%- capture pp -%}{%- if pour_single < 10 -%}00{{ pour_single }}{%- elsif pour_single < 100 -%}0{{ pour_single }}{%- else -%}{{ pour_single }}{%- endif -%}{%- endcapture -%}
    {%- capture pfname -%}bean_{{ pp }}.webp{%- endcapture -%}
    "{{ pfname | asset_url }}"
  {%- else -%}
    {%- assign base = section.settings.custom_base | strip -%}
    {%- for i in (1..roast_end) -%}
      {%- capture p -%}{%- if i < 10 -%}00{{ i }}{%- elsif i < 100 -%}0{{ i }}{%- else -%}{{ i }}{%- endif -%}{%- endcapture -%}
      "{{ base }}bean_{{ p }}.webp",
    {%- endfor -%}
    {%- capture pp -%}{%- if pour_single < 10 -%}00{{ pour_single }}{%- elsif pour_single < 100 -%}0{{ pour_single }}{%- else -%}{{ pour_single }}{%- endif -%}{%- endcapture -%}
    "{{ base }}bean_{{ pp }}.webp"
  {%- endif -%}
  ];

  var cfg = {
    root: document.getElementById('beanRoast-{{ sid }}'),
    frames: frames,
    captions: {{ section.settings.captions_json }},
    packRiseStart: {{ section.settings.pack_rise_start }} / 100,
    packVisible: {{ section.settings.pack_visible }} / 100,
    beanRoastEnd: {{ roast_end }},
    pourSingleFrame: {{ pour_single }},
    pourFall: {{ section.settings.pour_fall_distance }} / 100,
    pourVisible: {{ section.settings.pour_visible }} / 100,
    pourScale: {{ section.settings.pour_scale }} / 100,
    pourOffsetX: {{ section.settings.pour_offset_x }},
    pourOverlap: {{ section.settings.pour_overlap }} / 100,
    hasPack: {{ has_pack_image | json }}
  };

  if(!window.__beanRoastClean){
    window.__beanRoastClean = function(cfg){
      var root = cfg.root;
      if(!root) return;

      var track = root.querySelector('[data-br-track]');
      var stage = root.querySelector('[data-br-stage]');
      var view = root.querySelector('[data-br-view]');
      var cap = root.querySelector('[data-br-caption]');
      var load = root.querySelector('[data-br-loader]');
      var packOuter = root.querySelector('[data-br-pack-outer]');
      var pack = root.querySelector('[data-br-pack]');
      var packImg = pack ? pack.querySelector('img') : null;
      var cv = root.querySelector('[data-br-canvas]');
      var ctx = cv.getContext('2d', { alpha: true });

      var N = cfg.frames.length;
      var imgs = new Array(N);
      var done = 0;
      var ready = false;
      var cur = -1;
      var pending = false;
      var lastPour = null;
      var lastProg = 0;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var beanRoastEndIdx = Math.max(0, cfg.beanRoastEnd - 1);
      var pourSingleIdx = frames.length - 1;

      ctx.imageSmoothingEnabled = true;
      if('imageSmoothingQuality' in ctx) ctx.imageSmoothingQuality = 'high';

      function clamp(v){ return v < 0 ? 0 : (v > 1 ? 1 : v); }
      function ease(t){ return t < .5 ? 2*t*t : 1 - Math.pow(-2*t + 2, 2) / 2; }
      function prog(){
        var r = track.getBoundingClientRect();
        var tot = r.height - innerHeight;
        return tot <= 0 ? 0 : clamp(-r.top / tot);
      }
      function capFor(p){
        var c = cfg.captions.length ? cfg.captions[0][1] : '';
        for(var i = 0; i < cfg.captions.length; i++){
          if(p >= cfg.captions[i][0]) c = cfg.captions[i][1];
        }
        return c;
      }
      function frameIndex(p){
        if(!cfg.hasPack || p < cfg.packRiseStart){
          var t = cfg.hasPack ? p / cfg.packRiseStart : p;
          if(beanRoastEndIdx <= 0) return 0;
          return Math.min(beanRoastEndIdx, Math.floor(t * (beanRoastEndIdx + 1)));
        }
        return pourSingleIdx;
      }

      function updatePourFall(pr){
        if(!view) return;
        var e = ease(clamp(pr));
        var start = -Math.max(0.12, cfg.pourFall) * 100;
        var y = start * (1 - e);
        view.style.setProperty('--pour-y', y.toFixed(2) + '%');
      }

      function layoutPack(){
        if(!packOuter || !packImg || !packImg.complete) return;
        var vis = Math.max(0.5, cfg.packVisible);
        var fullH = packImg.offsetHeight || packImg.naturalHeight;
        if(!fullH) return;
        packOuter.style.height = Math.round(fullH * vis) + 'px';
        layoutPour();
      }

      function layoutPour(){
        if(!view || !packOuter || lastPour !== true) return;
        var packH = packOuter.offsetHeight;
        if(!packH) return;
        var overlap = packH * cfg.pourOverlap;
        view.style.bottom = Math.round(packH - overlap) + 'px';
      }

      function size(){
        var dpr = Math.min(devicePixelRatio || 1, 3);
        var r = cv.getBoundingClientRect();
        cv.width = Math.max(1, Math.round(r.width * dpr));
        cv.height = Math.max(1, Math.round(r.height * dpr));
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        layoutPack();
        if(ready) paint(cur < 0 ? 0 : cur, true, lastProg);
      }

      function paint(idx, force, p){
        if(idx === cur && !force) return;
        var im = imgs[idx];
        if(!im || !im.complete || !im.naturalWidth) return;
        cur = idx;
        lastProg = p;

        var r = cv.getBoundingClientRect();
        var cw = r.width;
        var ch = r.height;
        var iw = im.naturalWidth;
        var ih = im.naturalHeight;
        var inPour = cfg.hasPack && p >= cfg.packRiseStart;
        var scale, dw, dh, dx, dy;

        if(!inPour){
          scale = Math.min(cw / iw, ch / ih);
          dw = iw * scale;
          dh = ih * scale;
          dx = (cw - dw) * 0.5;
          dy = (ch - dh) * 0.5;
        } else {
          var vis = Math.max(0.35, cfg.pourVisible);
          scale = Math.max(cw / iw, (ch / vis) / ih) * cfg.pourScale;
          dw = iw * scale;
          dh = ih * scale;
          dx = (cw - dw) * 0.5 + (cfg.pourOffsetX / 100) * cw;
          dy = ch - dh;
        }

        ctx.clearRect(0, 0, cw, ch);
        ctx.drawImage(im, dx, dy, dw, dh);
      }

      function updatePack(p){
        if(!pack) return;
        var pr = clamp((p - cfg.packRiseStart) / (1 - cfg.packRiseStart));
        var e = ease(pr);
        var vis = Math.max(0.5, cfg.packVisible);
        var hidden = 1 - vis;
        var startY = 110;
        var endY = hidden * 100;
        var y = startY - e * (startY - endY);
        pack.style.transform = 'translateY(' + y.toFixed(2) + '%)';
        pack.style.opacity = pr > 0.001 ? '1' : '0';
      }

      function render(){
        pending = false;
        var p = reduce ? 1 : prog();
        var inPour = cfg.hasPack && p >= cfg.packRiseStart;
        var pourProgress = inPour ? clamp((p - cfg.packRiseStart) / (1 - cfg.packRiseStart)) : 0;
        var showPourCanvas = inPour && pourProgress > 0.1;

        if(inPour !== lastPour){
          lastPour = inPour;
          stage.classList.toggle('is-pour', inPour);
          requestAnimationFrame(size);
        }
        stage.classList.toggle('is-pouring', showPourCanvas);

        paint(frameIndex(p), false, p);
        updatePack(p);
        updatePourFall(pourProgress);
        layoutPour();

        if(cap){
          cap.textContent = capFor(p);
          cap.style.opacity = inPour ? '0' : '1';
        }
      }

      function onScroll(){
        if(pending) return;
        pending = true;
        requestAnimationFrame(render);
      }

      function preload(){
        for(var i = 0; i < N; i++){
          (function(i){
            var im = new Image();
            im.decoding = 'async';
            im.onload = im.onerror = function(){
              done++;
              if(load) load.textContent = 'Loading ' + Math.round(done / N * 100) + '%';
              if(done >= N){
                ready = true;
                if(load) load.style.display = 'none';
                size();
                render();
              }
            };
            im.src = cfg.frames[i];
            imgs[i] = im;
          })(i);
        }
        if(packImg){
          if(packImg.complete) layoutPack();
          else packImg.addEventListener('load', function(){ layoutPack(); render(); });
        }
      }

      var io = new IntersectionObserver(function(en){
        if(en[0].isIntersecting){ io.disconnect(); preload(); }
      }, { rootMargin: '600px 0px' });
      io.observe(track);

      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', size);
      size();
    };
  }

  if(document.readyState !== 'loading') window.__beanRoastClean(cfg);
  else document.addEventListener('DOMContentLoaded', function(){ window.__beanRoastClean(cfg); });
})();
</script>

{% schema %}
{
  "name": "Coffee Bean Roast",
  "tag": "section",
  "class": "section-coffee-bean-roast",
  "settings": [
    { "type": "header", "content": "Frames (bean roast + single pour frame)" },
    {
      "type": "select",
      "id": "frame_source",
      "label": "Frame source",
      "options": [
        { "value": "assets", "label": "Theme assets (/assets folder)" },
        { "value": "custom", "label": "Custom URL (Shopify Files / CDN)" }
      ],
      "default": "assets"
    },
    {
      "type": "text",
      "id": "custom_base",
      "label": "Custom base URL",
      "default": "https://your-cdn.com/bean-frames/"
    },
    {
      "type": "number",
      "id": "frame_count",
      "label": "Frame count (legacy)",
      "default": 116,
      "info": "Not used for loading. Roast frames + single pour frame are loaded automatically."
    },
    {
      "type": "number",
      "id": "bean_roast_end",
      "label": "Roast ends at frame",
      "default": 110,
      "info": "Last scroll frame for centered bean roast. Frames after this are not loaded."
    },
    {
      "type": "number",
      "id": "pour_single_frame",
      "label": "Single pour frame",
      "default": 116,
      "info": "One pour image only. No multi-frame pour scrub. Coffee falls via scroll motion into pack."
    },
    { "type": "header", "content": "Pack image (upload)" },
    {
      "type": "image_picker",
      "id": "pack_image",
      "label": "Pack image (transparent PNG/WebP)",
      "info": "Upload pack with transparent opening at top — coffee pours in behind it."
    },
    {
      "type": "range",
      "id": "pack_rise_start",
      "label": "Pack rise starts (% scroll)",
      "min": 55,
      "max": 90,
      "step": 1,
      "default": 72,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "pack_visible",
      "label": "Pack height shown",
      "min": 60,
      "max": 85,
      "step": 1,
      "default": 75,
      "unit": "%",
      "info": "75% = three-quarters visible, bottom quarter hidden."
    },
    {
      "type": "range",
      "id": "pack_width",
      "label": "Pack width",
      "min": 35,
      "max": 90,
      "step": 1,
      "default": 52,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "pack_max_width",
      "label": "Pack max width",
      "min": 280,
      "max": 800,
      "step": 20,
      "default": 520,
      "unit": "px"
    },
    { "type": "header", "content": "Pour alignment" },
    {
      "type": "range",
      "id": "pour_viewport_height",
      "label": "Pour window height",
      "min": 28,
      "max": 60,
      "step": 1,
      "default": 42,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "pour_visible",
      "label": "Pour crop (frame focus)",
      "min": 35,
      "max": 70,
      "step": 1,
      "default": 52,
      "unit": "%",
      "info": "Shows lower portion of frame where coffee stream falls."
    },
    {
      "type": "range",
      "id": "pour_scale",
      "label": "Pour zoom",
      "min": 85,
      "max": 130,
      "step": 1,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "pour_fall_distance",
      "label": "Pour fall distance",
      "min": 10,
      "max": 45,
      "step": 1,
      "default": 28,
      "unit": "%",
      "info": "How far the single pour frame drops into the pack during scroll."
    },
    {
      "type": "range",
      "id": "pour_overlap",
      "label": "Canvas overlap into pack",
      "min": 0,
      "max": 35,
      "step": 1,
      "default": 12,
      "unit": "%",
      "info": "How far coffee canvas overlaps pack opening."
    },
    {
      "type": "range",
      "id": "pour_offset_x",
      "label": "Pour horizontal nudge",
      "min": -20,
      "max": 20,
      "step": 1,
      "default": 0,
      "unit": "%"
    },
    { "type": "header", "content": "Bean display" },
    {
      "type": "range",
      "id": "bean_width",
      "label": "Width",
      "min": 40,
      "max": 100,
      "step": 1,
      "default": 78,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bean_height",
      "label": "Height",
      "min": 40,
      "max": 95,
      "step": 1,
      "default": 72,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "bean_max_width",
      "label": "Max width",
      "min": 400,
      "max": 1600,
      "step": 20,
      "default": 1200,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "bean_max_height",
      "label": "Max height",
      "min": 400,
      "max": 1200,
      "step": 20,
      "default": 1000,
      "unit": "px"
    },
    { "type": "header", "content": "Motion" },
    {
      "type": "range",
      "id": "scrub_vh",
      "label": "Scroll length",
      "min": 120,
      "max": 600,
      "step": 10,
      "default": 400,
      "unit": "vh"
    },
    { "type": "checkbox", "id": "show_caption", "label": "Show stage label", "default": true },
    {
      "type": "textarea",
      "id": "captions_json",
      "label": "Stage labels",
      "default": "[[0,\"Green\"],[0.30,\"Drying\"],[0.55,\"First Crack\"],[0.80,\"Developing\"],[0.92,\"Roasted\"]]"
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Roasted to order" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Watch it develop as you scroll" }
  ],
  "presets": [{ "name": "Coffee Bean Roast" }]
}
{% endschema %}
