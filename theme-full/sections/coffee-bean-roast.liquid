{%- comment -%}
  Coffee Bean Roast — clean placeholder.
  All frames removed. Upload fresh frames and set frame_count when ready.
{%- endcomment -%}

{%- assign sid = section.id -%}

<style>
  #beanRoast-{{ sid }} .br-stage{
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  #beanRoast-{{ sid }} .br-head{
    text-align: center;
    padding: 0 24px;
    max-width: 48rem;
    margin: 0 auto;
  }
</style>

<section id="beanRoast-{{ sid }}" class="coffee-bean-roast bg-[#E6D095]">
  <div class="br-stage" data-br-stage>
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="br-head">
        {% if section.settings.heading != blank %}
          <h2 class="font-display font-bold text-4xl lg:text-6xl text-ink leading-[1.05] tracking-tight">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="prose-brand mt-4">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Coffee Bean Roast",
  "tag": "section",
  "class": "section-coffee-bean-roast",
  "settings": [
    { "type": "header", "content": "Frames (upload fresh)" },
    {
      "type": "select",
      "id": "frame_source",
      "label": "Frame source",
      "options": [
        { "value": "assets", "label": "Theme assets (/assets folder)" },
        { "value": "custom", "label": "Custom URL (Shopify Files / CDN)" }
      ],
      "default": "assets"
    },
    {
      "type": "text",
      "id": "custom_base",
      "label": "Custom base URL",
      "default": "https://your-cdn.com/bean-frames/"
    },
    {
      "type": "number",
      "id": "frame_count",
      "label": "Total frames (max)",
      "default": 0,
      "info": "Set after uploading new bean_001.webp … bean_N.webp frames."
    },
    {
      "type": "number",
      "id": "frame_stop",
      "label": "Stop frames at",
      "default": 0,
      "info": "Last roast frame before pack rises. Set when frames are uploaded."
    },
    { "type": "header", "content": "Pack image (upload)" },
    {
      "type": "image_picker",
      "id": "pack_image",
      "label": "Pack image (transparent PNG/WebP)"
    },
    {
      "type": "range",
      "id": "pack_rise_start",
      "label": "Pack rise starts (% scroll)",
      "min": 55,
      "max": 90,
      "step": 1,
      "default": 78,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "pack_visible",
      "label": "Pack height shown",
      "min": 60,
      "max": 85,
      "step": 1,
      "default": 75,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "pack_width",
      "label": "Pack width",
      "min": 35,
      "max": 90,
      "step": 1,
      "default": 52,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "pack_max_width",
      "label": "Pack max width",
      "min": 280,
      "max": 800,
      "step": 20,
      "default": 520,
      "unit": "px"
    },
    { "type": "header", "content": "Bean display" },
    {
      "type": "range",
      "id": "bean_width",
      "label": "Width",
      "min": 40,
      "max": 100,
      "step": 1,
      "default": 78,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bean_height",
      "label": "Height",
      "min": 40,
      "max": 95,
      "step": 1,
      "default": 72,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "bean_max_width",
      "label": "Max width",
      "min": 400,
      "max": 1600,
      "step": 20,
      "default": 1200,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "bean_max_height",
      "label": "Max height",
      "min": 400,
      "max": 1200,
      "step": 20,
      "default": 1000,
      "unit": "px"
    },
    { "type": "header", "content": "Motion" },
    {
      "type": "range",
      "id": "scrub_vh",
      "label": "Scroll length",
      "min": 120,
      "max": 600,
      "step": 10,
      "default": 400,
      "unit": "vh"
    },
    { "type": "checkbox", "id": "show_caption", "label": "Show stage label", "default": false },
    {
      "type": "textarea",
      "id": "captions_json",
      "label": "Stage labels",
      "default": "[[0,\"Green\"],[0.30,\"Drying\"],[0.55,\"First Crack\"],[0.80,\"Developing\"],[0.92,\"Roasted\"]]"
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Roasted to order" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Watch it develop as you scroll" }
  ],
  "presets": [{ "name": "Coffee Bean Roast" }]
}
{% endschema %}
