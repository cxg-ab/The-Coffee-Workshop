{%- liquid
  assign frame_numbers = '001,041,081,122,162,203' | split: ','
  assign has_video = false
  if section.settings.video != blank
    assign has_video = true
  endif
  assign logo_max = section.settings.logo_size | default: 15
  assign logo_min = logo_max | times: 0.4 | round: 1
-%}

<style>
  .cs-page {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8vh 1.5rem 6vh;
    overflow: hidden;
  }

  .cs-page.is-fallback {
    background: #FFFFFF;
    opacity: 0;
    animation: cs-fade-in 1.1s ease-out 0.15s forwards;
  }
  @keyframes cs-fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-page.is-fallback { animation: none; opacity: 1; }
  }

  .cs-page.has-video {
    background: #0d0c0b;
  }
  .cs-video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0.5;
  }
  .cs-video-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.45) 0%,
      rgba(0,0,0,0.25) 35%,
      rgba(0,0,0,0.55) 100%
    );
  }
  .cs-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    animation: cs-fade-in 1.1s ease-out 0.15s forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-content { animation: none; opacity: 1; }
  }

  .cs-logo {
    max-height: clamp({{ logo_min }}rem, 14vw, {{ logo_max }}rem);
    width: auto;
    margin-bottom: 2.25rem;
  }
  .cs-page.has-video .cs-logo {
    filter: brightness(0) invert(1) drop-shadow(0 6px 24px rgba(0,0,0,0.5));
  }

  .cs-media-stage {
    position: relative;
    width: 180px;
    height: 180px;
    margin-bottom: 2.75rem;
    border: 1px solid #ece7dd;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 640px) {
    .cs-media-stage { width: 220px; height: 220px; }
  }
  .cs-bean-frame {
    position: absolute;
    width: 68%;
    height: 68%;
    top: 16%;
    left: 16%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 1.4s ease-in-out;
  }
  .cs-bean-frame.is-active { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .cs-bean-frame { transition: none; }
  }

  .cs-heading {
    font-family: var(--font-display), 'Playfair Display', serif;
    font-weight: 800;
    font-size: clamp(2rem, 6vw, 3.5rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.12;
    margin-bottom: 1.1rem;
    color: #1C1917;
  }
  .cs-sub {
    max-width: 30rem;
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.7;
    margin-bottom: 2.75rem;
    color: #6b6b6b;
  }

  .cs-page.has-video .cs-heading {
    color: #FFFFFF;
    text-shadow: 0 2px 4px rgba(0,0,0,0.6), 0 4px 24px rgba(0,0,0,0.5);
  }
  .cs-page.has-video .cs-sub {
    color: rgba(255,255,255,0.96);
    text-shadow: 0 1px 3px rgba(0,0,0,0.55), 0 2px 12px rgba(0,0,0,0.4);
  }

  .cs-notify {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    width: 100%;
    max-width: 25rem;
  }
  .cs-notify input[type="email"] {
    flex: 1 1 13rem;
    border: 1px solid #e8e4dc;
    background: #fff;
    padding: 0.85rem 1.1rem;
    font-size: 0.9rem;
    color: #1C1917;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .cs-notify input[type="email"]:focus { border-color: #C5A059; }
  .cs-notify button {
    background: #C5A059;
    color: #1C1917;
    border: none;
    padding: 0.9rem 1.9rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }
  .cs-notify button:hover { background: #1C1917; color: #fff; }

  .cs-page.has-video .cs-notify input[type="email"] {
    background: rgba(255,255,255,0.22);
    border: 1.5px solid rgba(255,255,255,0.6);
    color: #fff;
    backdrop-filter: blur(6px);
  }
  .cs-page.has-video .cs-notify input[type="email"]::placeholder {
    color: rgba(255,255,255,0.75);
  }
  .cs-page.has-video .cs-notify input[type="email"]:focus {
    border-color: #C5A059;
    background: rgba(255,255,255,0.3);
  }
  .cs-page.has-video .cs-notify button {
    box-shadow: 0 4px 20px rgba(197,160,89,0.45);
  }
  .cs-page.has-video .cs-notify button:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.35);
  }

  .cs-notify-success {
    font-size: 0.85rem;
    color: #6b6b6b;
  }
  .cs-page.has-video .cs-notify-success {
    color: #fff;
    text-shadow: 0 1px 3px rgba(0,0,0,0.5);
  }

  /* Password entry — restored here specifically, since this page is used
     via Shopify's native password protection: real visitors are gated,
     but you or anyone you give the password to can bypass it. Tucked in
     a quiet corner so it doesn't compete with the main brand moment. */
  .cs-password-corner {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 10;
    text-align: end;
  }
  .cs-password-toggle {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b8b3a8;
    background: none;
    border: none;
    cursor: pointer;
  }
  .cs-page.has-video .cs-password-toggle { color: rgba(255,255,255,0.6); }
  .cs-password-toggle:hover { color: #C5A059; }

  .cs-password-form {
    display: none;
    margin-top: 0.6rem;
    gap: 0.5rem;
    justify-content: flex-end;
    flex-wrap: wrap;
    width: 14rem;
  }
  .cs-password-form.is-open { display: flex; }
  .cs-password-form input[type="password"] {
    flex: 1 1 8rem;
    border: 1px solid #e8e4dc;
    padding: 0.5rem 0.7rem;
    font-size: 0.8rem;
    outline: none;
  }
  .cs-password-form input[type="password"]:focus { border-color: #C5A059; }
  .cs-password-form button {
    background: transparent;
    border: 1px solid #1C1917;
    color: #1C1917;
    padding: 0.5rem 0.9rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .cs-password-form button:hover { background: #1C1917; color: #fff; }
  .cs-password-error {
    width: 100%;
    text-align: right;
    font-size: 0.7rem;
    color: #b3413a;
    margin-top: 0.4rem;
  }

  @media (max-width: 480px) {
    .cs-password-corner { position: static; margin-top: 3rem; text-align: center; }
    .cs-password-form { justify-content: center; margin-left: auto; margin-right: auto; }
    .cs-password-error { text-align: center; }
  }
</style>

<div class="cs-page{% if has_video %} has-video{% else %} is-fallback{% endif %}">
  {%- if has_video -%}
    {{ section.settings.video | video_tag: class: 'cs-video-bg', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1920x' }}
    <div class="cs-video-scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="cs-content">
    {%- if settings.logo != blank -%}
      <img class="cs-logo" src="{{ settings.logo | image_url: width: 1100 }}" alt="{{ shop.name }}" width="550" height="auto">
    {%- endif -%}

    {%- unless has_video -%}
      <div class="cs-media-stage" data-cs-bean-stage>
        {%- for frame in frame_numbers -%}
          <img
            class="cs-bean-frame{% if forloop.first %} is-active{% endif %}"
            src="{{ 'bean_' | append: frame | append: '.webp' | asset_url }}"
            alt=""
            aria-hidden="true"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >
        {%- endfor -%}
      </div>
    {%- endunless -%}

    <h1 class="cs-heading">{{ section.settings.heading | default: 'Roasting in Progress' }}</h1>
    <p class="cs-sub">
      {{ section.settings.subheading | default: "Our specialty coffee experience is being carefully crafted — small batches, roasted with intention. We'll be ready to pour soon." }}
    </p>

    {% form 'customer', class: 'cs-notify' %}
      <input type="hidden" name="contact[tags]" value="coming-soon">
      {%- if form.posted_successfully? -%}
        <p class="cs-notify-success">Thanks — we'll let you know the moment we open.</p>
      {%- else -%}
        <label class="sr-only" for="cs-email">Email</label>
        <input id="cs-email" type="email" name="contact[email]" placeholder="Your email" required>
        <button type="submit">Notify Me</button>
      {%- endif -%}
    {% endform %}
  </div>

  <div class="cs-password-corner">
    <button type="button" class="cs-password-toggle" onclick="document.getElementById('cs-password-form').classList.toggle('is-open')">
      Store access
    </button>

    {% form 'storefront_password', class: 'cs-password-form', id: 'cs-password-form' %}
      <label class="sr-only" for="cs-password">Password</label>
      <input id="cs-password" type="password" name="password" placeholder="Password">
      <button type="submit">Enter</button>
      {%- if form.errors -%}
        <p class="cs-password-error">Incorrect password.</p>
      {%- endif -%}
    {% endform %}
  </div>
</div>

{%- unless has_video -%}
<script>
(function(){
  var stage = document.querySelector('[data-cs-bean-stage]');
  if(!stage) return;
  var frames = Array.prototype.slice.call(stage.querySelectorAll('.cs-bean-frame'));
  if(frames.length < 2) return;

  var index = 0;
  var direction = 1;

  setInterval(function(){
    frames[index].classList.remove('is-active');
    index += direction;
    if(index >= frames.length - 1) direction = -1;
    if(index <= 0) direction = 1;
    frames[index].classList.add('is-active');
  }, 2200);
})();
</script>
{%- endunless -%}

{% schema %}
{
  "name": "Coming Soon",
  "tag": "section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Coming soon video",
      "info": "If uploaded, plays full-screen (dimmed to 50%% visibility over a dark base) as the page background with text overlaid on top. If empty, falls back to the bean-roast frame animation on a white background."
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo size",
      "min": 6,
      "max": 18,
      "step": 0.5,
      "unit": "rem",
      "default": 15,
      "info": "Maximum height of the logo on larger screens. Scales down proportionally on mobile."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Roasting in Progress" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Our specialty coffee experience is being carefully crafted — small batches, roasted with intention. We'll be ready to pour soon." }
  ]
}
{% endschema %}
