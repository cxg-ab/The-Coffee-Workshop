<!-- visit-modern 2026-07-17T15:48:12.8925950+04:00 -->
{%- liquid
  assign visit_align = section.settings.content_align | default: 'left'
  if visit_align != 'left' and visit_align != 'right'
    assign visit_align = 'left'
  endif

  if section.settings.eyebrow != blank
    assign visit_eyebrow = section.settings.eyebrow
  else
    assign visit_eyebrow = 'visit.eyebrow' | t
  endif

  if section.settings.heading != blank
    assign visit_heading = section.settings.heading
  else
    assign visit_heading = 'visit.heading' | t
  endif

  if section.settings.cta_label != blank
    assign visit_cta = section.settings.cta_label
  else
    assign visit_cta = 'visit.directions' | t
  endif
-%}

<div
  id="visit-workshop"
  class="visit-modern visit-modern--{{ visit_align }}"
  data-visit-section
>
  <div class="site-container">
    <div class="visit-modern__panel" data-reveal>
      <header class="visit-modern__header">
        <div class="visit-modern__intro">
          <p class="visit-modern__eyebrow">{{ visit_eyebrow }}</p>
          <h2 class="visit-modern__title">{{ visit_heading }}</h2>
        </div>
        {%- if settings.brand_established != blank -%}
          <p class="visit-modern__est">Est. {{ settings.brand_established }}</p>
        {%- endif -%}
      </header>

      {%- if section.settings.paragraph_1 != blank -%}
        <p class="visit-modern__lead">{{ section.settings.paragraph_1 }}</p>
      {%- endif -%}

      <ul class="visit-modern__list">
        {%- if settings.contact_phone != blank -%}
          <li class="visit-modern__row">
            <span class="visit-modern__label">{{ 'visit.phone' | t }}</span>
            <a class="visit-modern__value" href="tel:{{ settings.contact_phone | replace: ' ', '' }}" dir="ltr">
              {{ settings.contact_phone }}
            </a>
          </li>
        {%- endif -%}

        {%- if settings.contact_email != blank -%}
          <li class="visit-modern__row">
            <span class="visit-modern__label">{{ 'visit.email' | t }}</span>
            <a class="visit-modern__value" href="mailto:{{ settings.contact_email }}">
              {{ settings.contact_email }}
            </a>
          </li>
        {%- endif -%}

        {%- if settings.contact_address != blank -%}
          <li class="visit-modern__row">
            <span class="visit-modern__label">{{ 'visit.address' | t }}</span>
            <span class="visit-modern__value visit-modern__value--text">{{ settings.contact_address }}</span>
          </li>
        {%- endif -%}

        {%- if settings.contact_website != blank -%}
          <li class="visit-modern__row">
            <span class="visit-modern__label">{{ 'visit.web' | t }}</span>
            <a
              class="visit-modern__value"
              href="https://{{ settings.contact_website | remove: 'https://' | remove: 'http://' | remove: 'www.' }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              {{ settings.contact_website }}
            </a>
          </li>
        {%- endif -%}
      </ul>

      {%- if settings.maps_url != blank -%}
        <div class="visit-modern__actions">
          <a
            href="{{ settings.maps_url }}"
            class="btn-primary visit-modern__cta"
            target="_blank"
            rel="noopener noreferrer"
          >
            {{ visit_cta }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Visit workshop",
  "tag": "section",
  "class": "visit-workshop-section",
  "settings": [
    {
      "type": "select",
      "id": "content_align",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Visit us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Coffee Workshop in RAK"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Description",
      "default": "Visit our specialty coffee workshop in Ras Al Khaimah — a hidden treasure for ethically conscious coffee, creative beverages, and one of the region's most desired blends."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Directions button",
      "default": "Get directions"
    }
  ],
  "presets": [
    {
      "name": "Visit workshop",
      "settings": {
        "content_align": "left"
      }
    }
  ]
}
{% endschema %}
