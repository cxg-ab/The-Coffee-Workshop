{%- comment -%}
  Hero — TCW landing (Cinematic Bold redesign).
  Structure (top → bottom on mobile; two-col from lg): eyebrow · rule · heading
  · subheading · CTA row · trust badges · visual.

  Motion strategy — Cinematic Bold (Jakub polish primary, Jhey for the single
  showcase moment, Emil restraint on repeated interactions):
  - Layered depth: a bronze aura layer parallaxes behind the circular visual.
  - Signature moment: a one-time bronze light-sweep passes across the hero on
    entrance (never loops — fires once, then never again).
  - Heading "materializes": word masks rise while a blur resolves to sharp.
  - Magnetic primary CTA on fine-pointer devices only.
  - All motion runs through the theme's GSAP timeline in animations.js, which is
    gated by prefers-reduced-motion and the Animations theme setting. This markup
    degrades to a clean, fully-visible static hero with no JS / reduced motion.
{%- endcomment -%}

{%- assign heading_scale = section.settings.heading_scale | default: 100 -%}
{%- assign sub_scale = section.settings.subheading_scale | default: 100 -%}
<section
  class="hero-section hero-section--cinematic relative overflow-hidden bg-white text-[#1C1917]"
  data-hero-section
  style="--hero-heading-scale: {{ heading_scale | divided_by: 100.0 }}; --hero-sub-scale: {{ sub_scale | divided_by: 100.0 }};"
>
  <div class="hero-clip" data-hero-clip>
    {% render 'hero-arabic-bg' %}

    {%- comment -%} Signature moment — one-time light sweep, driven by JS, hidden by default. {%- endcomment -%}
    <div class="hero-sweep" data-hero-sweep aria-hidden="true"></div>

    {%- comment -%}
      Coffee-bean floor — beans of varied size resting along the bottom edge.
      Roast stage is set by height off the floor: dark-roasted only at the very
      edge, semi-brown mid, raw green higher up. They settle on load, sway, and
      fall away on scroll (animations.js). Decorative, JS-gated.
    {%- endcomment -%}
    <div class="site-container relative z-10 grid items-center gap-6 py-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-10 lg:py-12">
    <div class="hero-copy relative z-20 max-w-2xl" data-hero-copy>
      {%- liquid
        assign hero_tagline = settings.brand_tagline | default: 'Specialty Coffee' | strip
        if hero_tagline == blank
          assign hero_tagline = 'Specialty Coffee'
        endif

        assign hero_eyebrow = section.settings.eyebrow | default: 'Est. 2018 · Ras Al Khaimah, UAE' | strip
        if hero_eyebrow == blank
          assign hero_eyebrow = 'Est. 2018 · Ras Al Khaimah, UAE'
        endif

        assign hero_heading = section.settings.heading | default: 'FINE COFFEE &<br>HAND SELECTED BEANS' | strip
        if hero_heading == blank
          assign hero_heading = 'FINE COFFEE &<br>HAND SELECTED BEANS'
        endif

        assign hero_subheading = section.settings.subheading | default: "The Coffee Workshop celebrates the art of fine coffee — sourcing the world's most remarkable beans and roasting them with precision and passion in Ras Al Khaimah to deliver a truly refined experience in every cup and every bean." | strip
        if hero_subheading == blank
          assign hero_subheading = "The Coffee Workshop celebrates the art of fine coffee — sourcing the world's most remarkable beans and roasting them with precision and passion in Ras Al Khaimah to deliver a truly refined experience in every cup and every bean."
        endif
      -%}

      <p class="hero-tagline mb-3" data-hero-tagline>{{ hero_tagline }}</p>

      <p class="section-eyebrow hero-eyebrow mb-4" data-hero-eyebrow>
        {{ hero_eyebrow }}
      </p>

      <div class="hero-brand-rule" aria-hidden="true"></div>

      <h1 class="hero-heading" data-hero-heading>
        {%- capture arabic_word_with_style -%}<br><span class="hero-heading__ar" lang="ar" dir="rtl">ماستر</span><br>{%- endcapture -%}
        {%- assign processed_heading = hero_heading
          | replace: 'MASTER', 'ماستر'
          | replace: 'Master', 'ماستر'
          | replace: 'ماستر', arabic_word_with_style
        -%}
        {%- assign heading_lines = processed_heading | split: '<br>' -%}
        {%- for line in heading_lines -%}
          {%- assign trimmed = line | strip -%}
          {%- if trimmed != blank -%}
            <span class="hero-heading__line" data-hero-heading-line style="display: block;">
              <span class="hero-heading__inner">{{ trimmed }}</span>
            </span>
          {%- endif -%}
        {%- endfor -%}
      </h1>

      <p class="hero-subheading" data-hero-stagger>
        {{ hero_subheading | escape | newline_to_br }}
      </p>

      {%- if section.settings.cta_label != blank -%}
        <div class="hero-cta-row" data-hero-stagger>
          <a
            href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}"
            class="hero-cta hero-cta--primary"
            data-magnetic="0.4"
          >
            <span class="hero-cta__label">{{ section.settings.cta_label }}</span>
            <span class="hero-cta__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </span>
          </a>
          {%- if section.settings.cta_secondary_label != blank -%}
            <a href="{{ section.settings.cta_secondary_link }}" class="hero-cta hero-cta--ghost">
              {{ section.settings.cta_secondary_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="hero-badges" data-hero-stagger role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' and block.settings.label != blank -%}
              <li class="hero-badge" {{ block.shopify_attributes }}>
                <span class="hero-badge__dot" aria-hidden="true"></span>
                <span>{{ block.settings.label }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="hero-3d-stage relative z-10 flex min-h-[240px] w-full shrink-0 items-center justify-center sm:min-h-[320px] lg:min-h-[440px]" data-hero-3d>
      {%- comment -%}
        The decorative medallion ring and the three blurred orbs were removed
        from this stage. Nothing else may live here: .hero-3d-stage is a
        centring flex row, so any extra child takes width and pushes the
        circle off-centre.
      {%- endcomment -%}
      <div
        class="hero-visual relative z-10 flex items-center justify-center"
        data-hero-visual
      >
        {%- if section.settings.hero_image != blank -%}
          {%- comment -%}
            LCP element. widths/sizes added so phones fetch a ~300-450px file
            instead of the full 900px one — previously every device downloaded
            the same 900px image regardless of the circle's rendered size.
          {%- endcomment -%}
          {{
            section.settings.hero_image
            | image_url: width: 900
            | image_tag:
              class: 'h-full w-full object-cover',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '300, 450, 600, 900',
              sizes: '(max-width: 640px) 60vw, (max-width: 1024px) 40vw, 440px',
              alt: section.settings.heading
          }}
        {%- elsif settings.logo != blank -%}
          {{
            settings.logo
            | image_url: width: 500
            | image_tag:
              class: 'h-auto max-h-56 w-auto px-10',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '200, 300, 500',
              sizes: '(max-width: 640px) 45vw, 280px',
              alt: shop.name
          }}
        {%- else -%}
          <span class="font-display text-center text-sm font-bold uppercase tracking-[0.2em] text-brand">
            {{ settings.brand_tagline | default: 'Specialty Coffee' }}
          </span>
        {%- endif -%}
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  /* ── Cinematic type scale. Bigger, tighter, more commanding than the base.
     Admin heading_scale multiplier + responsive clamp are both preserved. ── */
  .hero-section--cinematic .hero-heading {
    font-size: calc(clamp(2.5rem, 6vw, 4.75rem) * var(--hero-heading-scale, 1));
    line-height: 0.98;
    letter-spacing: -0.015em;
  }
  .hero-section--cinematic .hero-heading__ar {
    font-size: 0.82em;
    color: var(--color-brand, #8B5E3C);
  }

  /* Subheading */
  .hero-subheading {
    margin: 1.5rem 0 0;
    max-width: 48ch;
    font-size: calc(clamp(0.95rem, 1.1vw, 1.1rem) * var(--hero-sub-scale, 1));
    line-height: 1.7;
    color: var(--color-text-muted, #6B6B6B);
    font-weight: 300;
  }

  /* ── Signature moment: a single bronze light sweep on entrance. JS drives it;
     hidden by default so no-JS / reduced-motion never sees a flash. Fires once. ── */
  .hero-sweep {
    position: absolute;
    inset: 0;
    z-index: 30;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      104deg,
      transparent 34%,
      rgba(201, 169, 98, 0.22) 47%,
      rgba(255, 255, 255, 0.55) 50%,
      rgba(201, 169, 98, 0.22) 53%,
      transparent 66%
    );
    mix-blend-mode: screen;
    will-change: transform, opacity;
  }

  /* ── Primary CTA — bronze, tactile. Magnetic pull handled in JS (fine pointer
     only). Uses deep bronze (#8B5E3C, 5.6:1 on white) for AA contrast. ── */
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 2rem 0 0;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
    will-change: transform;
  }
  .hero-cta--primary {
    background: #8B5E3C;
    color: #fff;
    box-shadow: 0 10px 30px -12px rgba(139, 94, 60, 0.65);
  }
  .hero-cta--primary:hover {
    background: #6B4428;
    box-shadow: 0 16px 40px -12px rgba(139, 94, 60, 0.75);
  }
  .hero-cta--primary:active { transform: scale(0.97); }
  .hero-cta__icon {
    display: inline-flex;
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 0.3s ease;
  }
  .hero-cta--primary:hover .hero-cta__icon { transform: translateX(3px); }
  .hero-cta--ghost {
    color: var(--color-text, #1A1A1A);
    border: 1px solid var(--color-border, #E8E4DC);
  }
  .hero-cta--ghost:hover { border-color: #8B5E3C; color: #8B5E3C; }

  /* RTL: nudge the CTA arrow to point the reading direction. */
  [dir="rtl"] .hero-cta__icon { transform: scaleX(-1); }
  [dir="rtl"] .hero-cta--primary:hover .hero-cta__icon { transform: scaleX(-1) translateX(3px); }

  /* Trust badges — static gold marker, never a pulse loop. */
  .hero-badges {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.1rem;
    margin: 2rem 0 0; padding: 0; list-style: none;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--color-text-muted, #6B6B6B);
  }
  .hero-badge__dot {
    width: 0.45rem; height: 0.45rem; border-radius: 50%;
    background: var(--color-brand, #C5A059);
    flex-shrink: 0;
  }

  

  /* ── Reduced motion: kill the sweep entirely; everything else is static and
     already visible. The theme.liquid reduced-motion rule keeps hero-copy shown. ── */
  @media (prefers-reduced-motion: reduce) {
    .hero-sweep { display: none; }
    .hero-cta, .hero-cta__icon { transition: none; }
  }

  /* ── Mobile flicker guards ───────────────────────────────────────────
     Mouse tilt on the circle is disabled (initHero3DMouse is a no-op).
     Keep flat compositing on touch / small screens; settled class does the
     same after the one-shot entrance on desktop.

     The one-time entrance sweep is a full-hero mix-blend-mode: screen layer
     pinned above the circle (z-index 30) with a permanent will-change. Even
     at opacity 0 that keeps a blended composited layer over the logo for the
     life of the page. It is a decorative flourish, so it simply doesn't run
     on touch.
     ──────────────────────────────────────────────────────────────────── */
  .hero-visual.hero-visual--settled {
    will-change: auto;
    pointer-events: none;
    transform-style: flat;
  }
  @media (hover: none), (max-width: 767px) {
    .hero-visual {
      transform-style: flat;
      will-change: auto;
    }
    .hero-sweep { display: none; }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Est. 2018 · Ras Al Khaimah, UAE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Use <br> to force a line break (e.g. 'FINE COFFEE &<br>HAND-SELECTED BEANS').",
      "default": "FINE COFFEE &<br>HAND SELECTED BEANS"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "info": "One or two lines of supporting copy. Line breaks are respected.",
      "default": "The Coffee Workshop celebrates the art of fine coffee — sourcing the world's most remarkable beans and roasting them with precision and passion in Ras Al Khaimah to deliver a truly refined experience in every cup and every bean."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button label",
      "info": "Leave blank to hide the button.",
      "default": "Shop the beans"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary link label"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "info": "Percentage of the default size. Responsive scaling is preserved.",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "subheading_scale",
      "label": "Subheading size",
      "info": "Percentage of the default size.",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Visual"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image (optional)",
      "info": "Square or portrait image — displayed inside the circle."
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Roasted in RAK"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "badge", "settings": { "label": "Roasted in RAK" }},
        { "type": "badge", "settings": { "label": "Flat AED 30 shipping" }},
        { "type": "badge", "settings": { "label": "Small batches" }}
      ]
    }
  ]
}
{% endschema %}
