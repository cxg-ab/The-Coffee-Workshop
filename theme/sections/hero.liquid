{%- comment -%}
  Hero — TCW landing.
  Structure (top → bottom on mobile; two-col from lg): eyebrow · rule · heading
  · subheading · CTA row · trust badges · visual.

  Motion strategy (Jakub polish primary, Emil restraint for buttons/badges,
  Jhey allowed for heading word-mask — one deliberate moment only):
  - existing GSAP timeline in animations.js runs eyebrow/rule/headingLines/
    visual; we add the subheading + CTAs into that same rhythm via
    [data-reveal] so they inherit the same stagger and reduced-motion guard.
  - No infinite pulses. No blur-everywhere. No hover-scale on repeated items.
{%- endcomment -%}

{%- assign heading_scale = section.settings.heading_scale | default: 100 -%}
{%- assign sub_scale = section.settings.subheading_scale | default: 100 -%}
<section
  class="hero-section relative overflow-hidden bg-white text-[#1C1917]"
  data-hero-section
  style="--hero-heading-scale: {{ heading_scale | divided_by: 100.0 }}; --hero-sub-scale: {{ sub_scale | divided_by: 100.0 }};"
>
  <div class="hero-clip" data-hero-clip>
    {% render 'hero-arabic-bg' %}

    <div class="site-container relative z-10 grid items-center gap-4 py-4 lg:grid-cols-2 lg:gap-8 lg:py-6">
    <div class="hero-copy relative z-20 max-w-xl" data-hero-copy>
      {%- if settings.brand_tagline != blank -%}
        <p class="hero-tagline mb-3" data-hero-tagline>{{ settings.brand_tagline }}</p>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="section-eyebrow hero-eyebrow mb-4" data-hero-eyebrow>
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      <div class="hero-brand-rule" aria-hidden="true"></div>

      <h1 class="hero-heading" data-hero-heading>
        {%- capture arabic_word_with_style -%}<br><span class="hero-heading__ar" lang="ar" dir="rtl">ماستر</span><br>{%- endcapture -%}
        {%- assign processed_heading = section.settings.heading
          | replace: 'MASTER', 'ماستر'
          | replace: 'Master', 'ماستر'
          | replace: 'ماستر', arabic_word_with_style
        -%}
        {%- assign heading_lines = processed_heading | split: '<br>' -%}
        {%- for line in heading_lines -%}
          {%- assign trimmed = line | strip -%}
          {%- if trimmed != blank -%}
            <span class="hero-heading__line" data-hero-heading-line style="display: block;">
              <span class="hero-heading__inner">{{ trimmed }}</span>
            </span>
          {%- endif -%}
        {%- endfor -%}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="hero-subheading" data-reveal data-reveal-delay="0.15">
          {{ section.settings.subheading | escape | newline_to_br }}
        </p>
      {%- endif -%}

    </div>

    <div class="hero-3d-stage relative z-10 flex min-h-[140px] w-full shrink-0 items-center justify-center sm:min-h-[180px]" data-hero-3d>
      <div class="hero-orb absolute h-40 w-40 rounded-full bg-brand/25 blur-3xl" data-hero-orb></div>
      <div class="hero-orb absolute h-28 w-28 rounded-full bg-brand-light/35 blur-2xl" data-hero-orb></div>
      <div class="hero-orb absolute h-20 w-20 rounded-full bg-brand/15 blur-xl" data-hero-orb></div>

      <div
        class="hero-visual relative z-10 flex items-center justify-center rounded-full border border-line bg-surface shadow-brand"
        data-hero-visual
      >
        {%- if section.settings.hero_image != blank -%}
          {{
            section.settings.hero_image
            | image_url: width: 800
            | image_tag:
              class: 'h-full w-full rounded-full object-cover',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.heading
          }}
        {%- elsif settings.logo != blank -%}
          {{
            settings.logo
            | image_url: width: 400
            | image_tag:
              class: 'h-auto max-h-48 w-auto px-8',
              loading: 'eager',
              fetchpriority: 'high',
              alt: shop.name
          }}
        {%- else -%}
          <span class="font-display text-center text-sm font-bold uppercase tracking-[0.2em] text-brand">
            {{ settings.brand_tagline | default: 'Specialty Coffee' }}
          </span>
        {%- endif -%}
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  /* Admin-adjustable font size. Scales are multipliers (0.5–1.5) applied
     on top of the responsive clamp(), so responsive behaviour is kept. */
  .hero-section .hero-heading {
    font-size: calc(clamp(1.6rem, 3.2vw, 2.25rem) * var(--hero-heading-scale, 1));
  }
  /* Subheading: sits under the heading, brand-muted, comfortable measure. */
  .hero-subheading {
    margin: 1.25rem 0 0;
    max-width: 46ch;
    font-size: calc(clamp(0.95rem, 1.05vw, 1.05rem) * var(--hero-sub-scale, 1));
    line-height: 1.7;
    color: var(--color-text-muted, #6B6B6B);
    font-weight: 300;
  }

  /* Motion — the existing hero GSAP timeline handles eyebrow/rule/heading/
     visual entries. New children use [data-reveal] which already respects
     prefers-reduced-motion via the theme's global reveal handler. */
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Est. 2018 · Ras Al Khaimah, UAE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Use <br> to force a line break (e.g. 'FINE COFFEE &<br>HAND-SELECTED BEANS').",
      "default": "FINE COFFEE &<br>HAND-SELECTED BEANS"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "info": "One or two lines of supporting copy. Line breaks are respected.",
      "default": "The Coffee Workshop celebrates the art of fine coffee — sourcing the world's most remarkable beans and roasting them with precision and passion in Ras Al Khaimah to deliver a truly refined experience in every cup and every bean."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "info": "Percentage of the default size. Responsive scaling is preserved.",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "subheading_scale",
      "label": "Subheading size",
      "info": "Percentage of the default size.",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Visual"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image (optional)",
      "info": "Square or portrait image — displayed inside the circle."
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
