{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.product_limit | default: 4
-%}

<section class="home-shop-strip" data-home-shop-strip>
  <div class="site-container">
    <header class="home-shop-strip__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-eyebrow mb-2">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="home-shop-strip__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}" class="home-shop-strip__link">
          {{ section.settings.view_all_label }}
        </a>
      {%- endif -%}
    </header>

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="home-shop-strip__track" data-reveal>
        {%- for product in collection.products limit: limit -%}
          <div class="home-shop-strip__item">
            {% render 'product-card', card_product: product %}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="home-shop-strip__empty">{{ 'home.shop_strip.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home shop strip",
  "tag": "section",
  "class": "home-shop-strip-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fresh from the roastery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop specialty beans"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all beans"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    }
  ],
  "presets": [{ "name": "Home shop strip" }]
}
{% endschema %}
