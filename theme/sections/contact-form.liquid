<div class="relative overflow-hidden bg-canvas text-ink min-h-[80vh] flex items-center">
  <div class="site-container relative z-10 py-16 lg:py-32 w-full">
    <div class="grid gap-16 lg:gap-24 lg:grid-cols-2 items-center max-w-7xl mx-auto">

      <!-- Contact Info / Left Side -->
      <div data-reveal class="flex flex-col justify-center">
        <p class="section-eyebrow mb-6">{{ 'contact.eyebrow' | t }}</p>

        <h1 class="font-display text-5xl lg:text-7xl font-bold uppercase tracking-wide text-ink mb-8 leading-[1.1]">
          {{ 'contact.heading' | t }}
        </h1>

        <p class="prose-brand font-light leading-relaxed mb-12 text-lg max-w-md">
          {{ 'contact.intro' | t }}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Email -->
          <a href="mailto:{{ shop.email }}" class="brand-card group flex items-start gap-4 p-5">
            <div class="w-10 h-10 rounded-full border border-brand/30 flex items-center justify-center bg-brand/10 text-brand shrink-0 group-hover:bg-brand/20 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-muted mb-1">{{ 'contact.email_us' | t }}</h3>
              <span class="text-ink group-hover:text-brand transition-colors text-base font-medium break-all">{{ shop.email }}</span>
            </div>
          </a>

          <!-- Location -->
          <div class="brand-card flex items-start gap-4 p-5">
            <div class="w-10 h-10 rounded-full border border-brand/30 flex items-center justify-center bg-brand/10 text-brand shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-muted mb-1">{{ 'contact.location' | t }}</h3>
              <p class="text-ink text-base font-medium">{% if shop.address.city %}{{ shop.address.city }}, {{ shop.address.country }}{% else %}{{ 'contact.default_location' | t }}{% endif %}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form / Right Side -->
      <div data-reveal data-reveal-delay="0.15" class="brand-card p-8 sm:p-12 lg:p-16 relative overflow-hidden">

        <div class="mb-12 text-center">
          <h2 class="text-3xl lg:text-4xl font-display font-bold text-ink mb-3">{{ 'contact.form_heading' | t }}</h2>
          <p class="text-muted text-base">{{ 'contact.form_subheading' | t }}</p>
        </div>

        {%- form 'contact', id: 'ContactForm', class: 'relative z-10 space-y-6' -%}
          {%- if form.posted_successfully? -%}
            <div class="p-5 rounded-sm bg-brand/10 border border-brand/30 text-brand text-sm text-center font-bold mb-8">
              {{ 'contact.success_message' | t }}
            </div>
          {%- elsif form.errors -%}
            <div class="p-5 rounded-sm bg-red-50 border border-red-200 text-red-700 text-sm mb-8">
              <p class="font-bold mb-2">{{ 'contact.error_heading' | t }}</p>
              <ul class="list-disc pl-5">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      <a href="#ContactForm-{{ field }}" class="underline hover:text-brand">
                        {{ form.errors.translated_fields[field] | capitalize }}
                        {{ form.errors.messages[field] }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-[11px] font-bold uppercase tracking-[0.2em] text-muted ml-2" for="ContactForm-name">{{ 'contact.name_label' | t }}</label>
              <input class="w-full bg-surface border border-line rounded-sm px-6 py-4 text-ink placeholder-muted/60 focus:border-brand focus:bg-canvas focus:ring-1 focus:ring-brand/30 focus:outline-none transition-colors" autocomplete="name" type="text" id="ContactForm-name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ 'contact.name_placeholder' | t }}">
            </div>

            <div class="space-y-2">
              <label class="text-[11px] font-bold uppercase tracking-[0.2em] text-muted ml-2" for="ContactForm-email">{{ 'contact.email_label' | t }} <span class="text-brand">*</span></label>
              <input
                autocomplete="email"
                type="email"
                id="ContactForm-email"
                class="w-full bg-surface border border-line rounded-sm px-6 py-4 text-ink placeholder-muted/60 focus:border-brand focus:bg-canvas focus:ring-1 focus:ring-brand/30 focus:outline-none transition-colors"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                placeholder="hello@example.com"
                required
              >
            </div>
          </div>

          <div class="space-y-2">
            <label class="text-[11px] font-bold uppercase tracking-[0.2em] text-muted ml-2" for="ContactForm-phone">{{ 'contact.phone_label' | t }}</label>
            <input type="tel" id="ContactForm-phone" class="w-full bg-surface border border-line rounded-sm px-6 py-4 text-ink placeholder-muted/60 focus:border-brand focus:bg-canvas focus:ring-1 focus:ring-brand/30 focus:outline-none transition-colors" autocomplete="tel" name="contact[phone]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="{{ 'contact.phone_placeholder' | t }}">
          </div>

          <div class="space-y-2">
            <label class="text-[11px] font-bold uppercase tracking-[0.2em] text-muted ml-2" for="ContactForm-body">{{ 'contact.message_label' | t }}</label>
            <textarea
              rows="4"
              id="ContactForm-body"
              class="w-full bg-surface border border-line rounded-sm px-6 py-4 text-ink placeholder-muted/60 focus:border-brand focus:bg-canvas focus:ring-1 focus:ring-brand/30 focus:outline-none transition-colors resize-none"
              name="contact[body]"
              placeholder="{{ 'contact.message_placeholder' | t }}"
            >{{- form.body -}}</textarea>
          </div>

          <div class="pt-4">
            <button type="submit" class="btn-primary w-full flex items-center justify-center">
              <span>{{ 'contact.submit' | t }}</span>
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
