<div class="relative overflow-hidden bg-[#1C1917] text-[#FAF9F6] min-h-[80vh] flex items-center">
  <div class="site-container relative z-10 py-16 lg:py-32 w-full">
    <div class="grid gap-16 lg:gap-24 lg:grid-cols-2 items-center max-w-7xl mx-auto">
      
      <!-- Contact Info / Left Side -->
      <div data-reveal class="flex flex-col justify-center">
        <!-- Eyebrow -->
        <div class="flex items-center gap-4 mb-6">
          <div class="h-[1px] w-12 bg-[#C5A059]"></div>
          <span class="text-xs tracking-[0.3em] font-bold uppercase text-[#C5A059]">Get in Touch</span>
        </div>
        
        <!-- Heading -->
        <h1 class="font-display text-5xl lg:text-7xl font-bold uppercase tracking-wide text-white mb-8 leading-[1.1]">
          Contact Us
        </h1>
        
        <!-- Description -->
        <p class="text-white/70 font-light leading-relaxed mb-12 text-lg max-w-md">
          We would love to hear from you. Whether you have a question about our coffee, subscriptions, or anything else, our team is ready to answer all your questions.
        </p>
        
        <!-- Contact Details -->
        <div class="space-y-6">
          <!-- Email -->
          <div class="flex items-center gap-4 group">
            <div class="w-10 h-10 rounded-full border border-[#C5A059]/30 flex items-center justify-center bg-[#C5A059]/10 text-[#C5A059] shrink-0 group-hover:bg-[#C5A059]/20 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/40 mb-1">Email Us</h3>
              <a href="mailto:{{ shop.email }}" class="text-white hover:text-[#C5A059] transition-colors text-lg font-medium">{{ shop.email }}</a>
            </div>
          </div>
          
          <!-- Location -->
          <div class="flex items-center gap-4 group">
            <div class="w-10 h-10 rounded-full border border-[#C5A059]/30 flex items-center justify-center bg-[#C5A059]/10 text-[#C5A059] shrink-0 group-hover:bg-[#C5A059]/20 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/40 mb-1">Location</h3>
              <p class="text-white text-lg font-medium">{% if shop.address.city %}{{ shop.address.city }}, {{ shop.address.country }}{% else %}Dubai, United Arab Emirates{% endif %}</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Contact Form / Right Side -->
      <div data-reveal data-reveal-delay="0.15" class="bg-[#1C1917] rounded-[2.5rem] p-8 sm:p-12 lg:p-16 relative overflow-hidden shadow-2xl border border-white/5">
        
        <div class="mb-12 text-center">
          <h2 class="text-3xl lg:text-4xl font-display text-white mb-3">Send a Message</h2>
          <p class="text-white/50 text-base">Fill out the form below and we'll get back to you.</p>
        </div>

        {%- form 'contact', id: 'ContactForm', class: 'relative z-10 space-y-6' -%}
          {%- if form.posted_successfully? -%}
            <div class="p-5 rounded-2xl bg-[#C5A059]/20 border border-[#C5A059]/30 text-[#C5A059] text-sm text-center font-bold mb-8">
              Thanks for contacting us. We will get back to you as soon as possible.
            </div>
          {%- elsif form.errors -%}
            <div class="p-5 rounded-2xl bg-red-500/20 border border-red-500/30 text-red-200 text-sm mb-8">
              <p class="font-bold mb-2">Please adjust the following:</p>
              <ul class="list-disc pl-5">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      <a href="#ContactForm-{{ field }}" class="underline hover:text-[#C5A059]">
                        {{ form.errors.translated_fields[field] | capitalize }}
                        {{ form.errors.messages[field] }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/70 ml-2" for="ContactForm-name">Name</label>
              <input class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white placeholder-white/20 focus:border-[#C5A059] focus:bg-white/10 focus:ring-1 focus:ring-[#C5A059] focus:outline-none transition-all" autocomplete="name" type="text" id="ContactForm-name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="John Doe">
            </div>
            
            <div class="space-y-2">
              <label class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/70 ml-2" for="ContactForm-email">Email <span class="text-[#C5A059]">*</span></label>
              <input
                autocomplete="email"
                type="email"
                id="ContactForm-email"
                class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white placeholder-white/20 focus:border-[#C5A059] focus:bg-white/10 focus:ring-1 focus:ring-[#C5A059] focus:outline-none transition-all"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                placeholder="hello@example.com"
                required
              >
            </div>
          </div>

          <div class="space-y-2">
            <label class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/70 ml-2" for="ContactForm-phone">Phone Number</label>
            <input type="tel" id="ContactForm-phone" class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white placeholder-white/20 focus:border-[#C5A059] focus:bg-white/10 focus:ring-1 focus:ring-[#C5A059] focus:outline-none transition-all" autocomplete="tel" name="contact[phone]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="+971 50 123 4567">
          </div>

          <div class="space-y-2">
            <label class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/70 ml-2" for="ContactForm-body">Message</label>
            <textarea
              rows="4"
              id="ContactForm-body"
              class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white placeholder-white/20 focus:border-[#C5A059] focus:bg-white/10 focus:ring-1 focus:ring-[#C5A059] focus:outline-none transition-all resize-none"
              name="contact[body]"
              placeholder="How can we help you?"
            >{{- form.body -}}</textarea>
          </div>

          <div class="pt-4">
            <button type="submit" class="group flex items-center justify-center w-full rounded-2xl bg-[#C5A059] py-5 px-8 text-sm font-bold uppercase tracking-[0.2em] text-[#1C1917] transition-all duration-300 hover:bg-white hover:shadow-[0_10px_30px_rgba(255,255,255,0.15)] hover:-translate-y-1">
              <span>Send Message</span>
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
