<section class="about-story-section about-story-section--compact" data-about-section>
  <div class="about-liquid-bg about-liquid-bg--reduced" aria-hidden="true">
    <span class="about-liquid-blob about-liquid-blob--1" data-about-glow></span>
    <span class="about-liquid-blob about-liquid-blob--2 about-liquid-blob--desktop-only" data-parallax="0.35"></span>
  </div>

  <div class="site-container relative z-10">
    <div class="about-glass-shell">
      <div class="about-glass-panel about-glass-panel--compact">
        <header class="about-glass-header" data-about-intro>
          <div class="about-glass-header__copy">
            <p class="section-eyebrow mb-3" data-about-item>{{ section.settings.eyebrow }}</p>
            <div class="about-story-rule" aria-hidden="true"></div>
            <h2 class="about-glass-title" data-about-item>{{ section.settings.heading }}</h2>
          </div>
          {%- if settings.brand_established != blank -%}
            <p class="about-glass-est" data-about-item>Est. {{ settings.brand_established }}</p>
          {%- endif -%}
        </header>

        <div class="about-glass-body" data-about-body>
          <div class="about-glass-copy">
            {%- if section.settings.paragraph_1 != blank -%}
              <p class="about-glass-prose" data-about-item>{{ section.settings.paragraph_1 }}</p>
            {%- endif -%}
            {%- if section.settings.paragraph_2 != blank -%}
              <p class="about-glass-prose" data-about-item>{{ section.settings.paragraph_2 }}</p>
            {%- endif -%}
          </div>

          {%- if section.blocks.size > 0 -%}
            <div class="about-glass-values" data-about-values>
              {%- for block in section.blocks -%}
                <article class="about-value-card about-value-card--glass" data-about-card {{ block.shopify_attributes }}>
                  <span class="about-value-card__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <h3 class="about-value-card__title">{{ block.settings.title }}</h3>
                  <p class="about-value-card__text">{{ block.settings.text }}</p>
                </article>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "tag": "section",
  "class": "about-story-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specialty coffee, roasted with purpose" },
    { "type": "textarea", "id": "paragraph_1", "label": "Paragraph 1", "default": "Founded in 2018, The Coffee Workshop is a team of coffee professionals with deep expertise in serving and roasting green coffee beans." },
    { "type": "textarea", "id": "paragraph_2", "label": "Paragraph 2", "default": "We roast in small batches on our store roaster — maintaining consistency from batch to batch while bringing out the best qualities of each micro-lot." }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Honest sourcing" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Long-term trading relationships with farmers and their families." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand story",
      "blocks": [
        { "type": "value", "settings": { "title": "Micro-lots", "text": "We discover, sample, confirm, and reserve the finest bean kinds from micro lots worldwide." }},
        { "type": "value", "settings": { "title": "Master roasters", "text": "Each origin roasted to achieve the greatest results from every batch." }},
        { "type": "value", "settings": { "title": "UAE specialty", "text": "Raising the quality of specialty coffee available across the Emirates." }}
      ]
    }
  ]
}
{% endschema %}
