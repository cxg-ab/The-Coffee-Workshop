{%- comment -%}
  Coffee Bean Roast — scroll scrub frames (bean_001..bean_N).
  Stop frame setting chooses last frame shown during scroll.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign total_frames = section.settings.frame_count -%}
{%- assign phone_scrub_vh = section.settings.scrub_vh | times: 0.55 | round -%}
{%- assign tablet_scrub_vh = section.settings.scrub_vh | times: 0.75 | round -%}

<style>
  #beanRoast-{{ sid }}{
    --scrub-vh: {{ section.settings.scrub_vh }};
    --bean-w: {{ section.settings.bean_width }}%;
    --bean-h: {{ section.settings.bean_height }}vh;
    --bean-max-w: {{ section.settings.bean_max_width }}px;
    --bean-max-h: {{ section.settings.bean_max_height }}px;
    --br-canvas: var(--color-bg, #FAFAF8);
    --br-bronze: var(--color-brand, #8B5E3C);
    --br-line: var(--color-border, #E8E4DC);
    --br-header: var(--tcw-header-h, 5rem);
    --br-safe-t: env(safe-area-inset-top, 0px);
    --br-safe-b: env(safe-area-inset-bottom, 0px);
    /* Stage height ladder. Custom properties parse permissively, so a plain
       "last declaration wins" fallback does NOT work here — an unsupported
       unit still overrides and only fails later, at computed-value time,
       collapsing the sticky stage to height:auto. Each upgrade therefore
       has to be gated behind @supports.
       Base vh works everywhere (incl. iOS < 15.4); svh/dvh (iOS 15.4+)
       additionally handle the iPhone URL bar showing/hiding. */
    --br-stage-h: calc(100vh - var(--br-header));
    background: var(--br-canvas);
    isolation: isolate;
  }
  @supports (height: 100svh) {
    #beanRoast-{{ sid }}{ --br-stage-h: calc(100svh - var(--br-header)); }
  }
  @supports (height: 100dvh) {
    #beanRoast-{{ sid }}{ --br-stage-h: calc(100dvh - var(--br-header)); }
  }

  #beanRoast-{{ sid }} .br-track{position:relative;height:calc(var(--scrub-vh) * 1vh)}
  #beanRoast-{{ sid }} .br-stage{
    position:sticky;top:var(--br-header);
    height:var(--br-stage-h);
    min-height:280px;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:clamp(0.5rem, 1.5vh, 1.25rem);
    padding:
      max(0.75rem, var(--br-safe-t))
      clamp(0.75rem, 3vw, 1.5rem)
      max(0.75rem, var(--br-safe-b));
    box-sizing:border-box;
    overflow:hidden;
    background:
      radial-gradient(ellipse 68% 52% at 50% 78%, rgba(139, 94, 60, 0.07), transparent 72%),
      radial-gradient(ellipse 100% 80% at 50% 35%, transparent 45%, rgba(232, 228, 220, 0.4) 100%),
      var(--br-canvas);
  }
  #beanRoast-{{ sid }} .br-head{
    position:relative;flex:0 0 auto;width:100%;max-width:40rem;
    text-align:center;z-index:4;pointer-events:none;
  }
  #beanRoast-{{ sid }} .br-head h2{
    font-size:clamp(1.5rem, 4.2vw + 0.6rem, 3.75rem);
    line-height:1.05;
  }
  #beanRoast-{{ sid }} .br-head .prose-brand{
    margin-top:0.5rem;
    font-size:clamp(0.875rem, 1.2vw + 0.7rem, 1.125rem);
  }
  #beanRoast-{{ sid }} .br-view{
    position:relative;z-index:2;
    flex:1 1 auto;
    width:min(var(--bean-w), var(--bean-max-w), 100%);
    height:auto;
    max-height:min(var(--bean-h), var(--bean-max-h), 100%);
    aspect-ratio:1 / 1;
    max-width:100%;
    border:none;outline:none;box-shadow:none;background:transparent;
  }
  #beanRoast-{{ sid }} .br-canvas{
    width:100%;height:100%;display:block;
    background:transparent;border:none;outline:none;box-shadow:none;
    filter:none;
  }
  #beanRoast-{{ sid }} .br-loader{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    pointer-events:none;
  }
  #beanRoast-{{ sid }} .br-caption{
    position:relative;flex:0 0 auto;width:100%;
    text-align:center;
    font-size:.75rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;
    color:rgba(28,25,23,.55);pointer-events:none;z-index:4;
  }

  /* Phones */
  @media (max-width: 640px) {
    #beanRoast-{{ sid }} { --scrub-vh: {{ phone_scrub_vh }}; }
    #beanRoast-{{ sid }} .br-stage{
      gap:0.35rem;
      padding-inline:0.75rem;
    }
    #beanRoast-{{ sid }} .br-view{
      width:min(92vw, 100%);
      max-height:min(72svh, calc(var(--br-stage-h) - 5.5rem));
    }
  }

  /* Large phones / small tablets */
  @media (min-width: 641px) and (max-width: 768px) {
    #beanRoast-{{ sid }} { --scrub-vh: {{ phone_scrub_vh }}; }
    #beanRoast-{{ sid }} .br-view{
      width:min(86vw, 34rem);
      max-height:min(76svh, calc(var(--br-stage-h) - 5rem));
    }
  }

  /* iPad portrait & compact tablets */
  @media (min-width: 769px) and (max-width: 1024px) {
    #beanRoast-{{ sid }} { --scrub-vh: {{ tablet_scrub_vh }}; }
    #beanRoast-{{ sid }} .br-view{
      width:min(78vw, 40rem);
      max-height:min(78svh, calc(var(--br-stage-h) - 6rem));
    }
  }

  /* iPad landscape / small laptops */
  @media (min-width: 769px) and (max-width: 1180px) and (orientation: landscape) {
    #beanRoast-{{ sid }} { --scrub-vh: {{ tablet_scrub_vh }}; }
    #beanRoast-{{ sid }} .br-stage{
      flex-direction:row;
      flex-wrap:wrap;
      justify-content:center;
      align-content:center;
      gap:1rem 2rem;
    }
    #beanRoast-{{ sid }} .br-head{
      flex:1 1 16rem;
      max-width:22rem;
      text-align:left;
    }
    #beanRoast-{{ sid }} .br-view{
      flex:0 1 auto;
      width:min(52vh, 52vw, 28rem);
      max-height:min(70svh, calc(var(--br-stage-h) - 2rem));
    }
    #beanRoast-{{ sid }} .br-caption{
      flex:1 1 100%;
      text-align:center;
    }
  }

  @media (prefers-reduced-motion: reduce){
    #beanRoast-{{ sid }} .br-track{height:auto}
    #beanRoast-{{ sid }} .br-stage{position:static;height:auto;min-height:0;padding:14vh 0}
  }
</style>

<section id="beanRoast-{{ sid }}" class="coffee-bean-roast">
  <div class="br-track" data-br-track>
    <div class="br-stage" data-br-stage>
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="br-head">
        {% if section.settings.heading != blank %}<h2 class="font-display font-bold text-ink tracking-tight" data-split-title>{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.subheading != blank %}<p class="prose-brand">{{ section.settings.subheading }}</p>{% endif %}
      </div>
      {%- endif -%}

      <div class="br-view" data-br-view>
        <canvas class="br-canvas" data-br-canvas aria-hidden="true"></canvas>
        <div class="br-loader text-brand font-semibold tracking-widest text-xs uppercase opacity-50" data-br-loader>Loading 0%</div>
      </div>

      {% if section.settings.show_caption %}
        <div class="br-caption" data-br-caption>Green</div>
      {% endif %}
    </div>
  </div>
</section>

<script>
(function(){
  var frames = [
  {%- if section.settings.frame_source == 'assets' -%}
    {%- for i in (1..total_frames) -%}
      {%- capture p -%}{%- if i < 10 -%}00{{ i }}{%- elsif i < 100 -%}0{{ i }}{%- else -%}{{ i }}{%- endif -%}{%- endcapture -%}
      {%- capture fname -%}bean_{{ p }}.webp{%- endcapture -%}
      "{{ fname | asset_url }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  {%- else -%}
    {%- assign base = section.settings.custom_base | strip -%}
    {%- for i in (1..total_frames) -%}
      {%- capture p -%}{%- if i < 10 -%}00{{ i }}{%- elsif i < 100 -%}0{{ i }}{%- else -%}{{ i }}{%- endif -%}{%- endcapture -%}
      "{{ base }}bean_{{ p }}.webp"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  {%- endif -%}
  ];

  /* Phone-sized variants — real 720x720 assets (bean_sm_001..N.webp), NOT a
     CDN resize. The source frames are 1440x1440, ~8.3MB each once decoded,
     which is the root of the iOS blank-canvas failure; at 720px a frame
     decodes to ~2.1MB (4x less) and still out-resolves the phone canvas
     (~594px at the capped dpr).

     These were generated as separate assets on purpose. The previous attempt
     used `asset_img_url: '720x'`, which asks Shopify's image service to
     produce a `_720x` variant of the .webp — and instead of failing, it
     returned Shopify's grey "No image" placeholder with a 200. That defeated
     the onerror fallback below (nothing errored), so every phone frame
     painted the placeholder: scrubbing worked, no bean. Plain asset_url on a
     file that really exists cannot fail that way, and a genuinely missing
     asset now 404s, which the fallback does catch. */
  var framesSm = [
  {%- if section.settings.frame_source == 'assets' -%}
    {%- for i in (1..total_frames) -%}
      {%- capture p -%}{%- if i < 10 -%}00{{ i }}{%- elsif i < 100 -%}0{{ i }}{%- else -%}{{ i }}{%- endif -%}{%- endcapture -%}
      {%- capture fname_sm -%}bean_sm_{{ p }}.webp{%- endcapture -%}
      "{{ fname_sm | asset_url }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  {%- endif -%}
  ];

  var cfg = {
    root: document.getElementById('beanRoast-{{ sid }}'),
    frames: frames,
    framesSm: framesSm,
    captions: {{ section.settings.captions_json }},
    frameStop: {{ section.settings.frame_stop }}
  };

  if(!window.__beanRoastClean){
    window.__beanRoastClean = function(cfg){
      var root = cfg.root;
      if(!root) return;

      var track = root.querySelector('[data-br-track]');
      var cap = root.querySelector('[data-br-caption]');
      var load = root.querySelector('[data-br-loader]');
      var cv = root.querySelector('[data-br-canvas]');
      var ctx = cv.getContext('2d', { alpha: true });

      var N = cfg.frames.length;
      var imgs = new Array(N);
      var done = 0;
      var targetLoads = N;
      var ready = false;
      var cur = -1;
      var pending = false;
      var reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
      var reduce = reduceMq.matches;
      var phoneMq = window.matchMedia('(max-width: 640px)');
      var tabletMq = window.matchMedia('(min-width: 641px) and (max-width: 1024px)');
      var stopIdx = Math.max(0, Math.min(N - 1, cfg.frameStop - 1));

      function isPhone(){ return phoneMq.matches; }
      function isTablet(){ return tabletMq.matches; }
      function isCompact(){ return isPhone() || isTablet(); }

      function loadBudget(){
        /* Frames past stopIdx are never displayed on any device (roastIndex
           clamps to stopIdx), so the load budget is capped there for both
           mobile and desktop — avoids requesting frames that will never
           be shown, and avoids 404s if frame_count/frame_stop drift from
           the number of frames actually exported to /assets. */
        return Math.min(N, Math.max(stopIdx + 1, 1));
      }

      function readyThreshold(){
        var budget = loadBudget();
        if(isPhone()) return Math.min(5, budget);
        if(isTablet()) return Math.min(8, budget);
        return Math.min(12, budget);
      }

      function maxConcurrent(){
        if(isPhone()) return 3;
        if(isTablet()) return 6;
        return 10;
      }

      function maxDpr(){
        /* PERF: every scrub frame does a drawImage from a 1440x1440 source
           (~7.9MB decoded). Canvas pixel count is the dominant per-frame
           raster cost, and it scales with dpr^2. Capping dpr on phones cuts
           that work ~44% with no visible loss on a photographic sequence
           at this display size. */
        if(isPhone()) return 1.5;
        if(isTablet()) return 2;
        return 2.5;
      }

      ctx.imageSmoothingEnabled = true;
      if('imageSmoothingQuality' in ctx) ctx.imageSmoothingQuality = 'high';

      function clamp(v){ return v < 0 ? 0 : (v > 1 ? 1 : v); }
      function viewportH(){
        if(window.visualViewport && window.visualViewport.height) return window.visualViewport.height;
        return window.innerHeight || document.documentElement.clientHeight;
      }
      function prog(){
        var r = track.getBoundingClientRect();
        var tot = r.height - viewportH();
        return tot <= 0 ? 0 : clamp(-r.top / tot);
      }
      function capFor(p){
        var c = cfg.captions.length ? cfg.captions[0][1] : '';
        for(var i = 0; i < cfg.captions.length; i++){
          if(p >= cfg.captions[i][0]) c = cfg.captions[i][1];
        }
        return c;
      }
      /* On smaller screens, only load/show every Nth frame. All 217 frames
         (1440x1440, ~47MB over the wire) is far more than a phone or tablet
         can hold decoded; stepping cuts network and memory 2-4x while keeping
         the roast visibly smooth — the subject barely moves between adjacent
         frames, so the scrub still reads as continuous. */
      function frameStep(){
        if(isPhone()) return 4;
        if(isTablet()) return 2;
        return 2; /* desktop: every 2nd frame (~108 of 217) — halves the
                     lazy-loaded roast download (~47MB -> ~24MB) with a scrub
                     still smooth enough at this length. */
      }
      function roastIndex(p){
        if(stopIdx <= 0) return 0;
        var idx = Math.min(stopIdx, Math.floor(p * (stopIdx + 1)));
        var step = frameStep();
        if(step > 1){
          idx = Math.round(idx / step) * step;
          if(idx > stopIdx) idx = stopIdx;
        }
        return idx;
      }

      function size(){
        var dpr = Math.min(devicePixelRatio || 1, maxDpr());
        var r = cv.getBoundingClientRect();
        var w = Math.max(1, Math.round(r.width * dpr));
        var h = Math.max(1, Math.round(r.height * dpr));
        /* Writing cv.width/height clears the canvas even when the value is
           unchanged, so bail when nothing actually moved. iOS fires
           visualViewport resize continuously while the URL bar slides. */
        if(w === cv.width && h === cv.height) return;
        cv.width = w;
        cv.height = h;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        if(ready && cur >= 0) paint(cur, true);
      }

      /* Phones pull the 720px variant; everything else the full frame. If a
         bean_sm_* asset is genuinely missing it 404s, and the first failure
         flips smallOk so exactly one frame pays a wasted request instead of
         all 55 — the section then runs at full resolution. */
      var smallOk = true;
      function srcFor(i){
        if(smallOk && isPhone() && cfg.framesSm && cfg.framesSm[i]) return cfg.framesSm[i];
        return cfg.frames[i];
      }

      function requestFrame(i){
        if(i < 0 || i >= N || imgs[i]) return;
        var im = new Image();
        var retried = false;
        im.decoding = 'async';
        im.onload = function(){
          if(ready) paint(roastIndex(prog()), true);
        };
        im.onerror = function(){
          if(!retried && im.src !== cfg.frames[i]){
            retried = true;
            smallOk = false;
            im.src = cfg.frames[i];
            return;
          }
          if(ready) paint(roastIndex(prog()), true);
        };
        im.src = srcFor(i);
        imgs[i] = im;
      }

      function usable(i){
        var im = imgs[i];
        return !!(im && im.complete && im.naturalWidth);
      }
      /* Nearest already-decoded frame to idx. Without this, a first paint on
         an unloaded frame returned early and left the canvas blank — on a
         section whose only content is the canvas that reads as a white
         screen, and it never self-corrected because paint() early-returns
         while idx === cur. Now any decoded frame is shown immediately and
         the exact one swaps in when it arrives. */
      function nearestLoaded(idx){
        if(usable(idx)) return idx;
        for(var d = 1; d <= N; d++){
          if(idx - d >= 0 && usable(idx - d)) return idx - d;
          if(idx + d <= stopIdx && usable(idx + d)) return idx + d;
        }
        return -1;
      }

      /* Bound retained frames on phones so the purge above stops happening in
         the first place. Unbounded, this held ~73 frames at 1440x1440: roughly
         600MB decoded, far past iOS Safari's per-tab ceiling. With the 720px
         variants, step 4 and this window it settles near 40MB.
         Only fully-loaded frames are released — releasing an in-flight one
         would strand preload()'s `active` counter and stall the queue.
         Released frames come back from the HTTP cache, and nearestLoaded()
         covers the gap meanwhile. */
      var KEEP = 36;
      var lastTrim = -1e9;
      function trim(center){
        if(!isPhone()) return;
        if(Math.abs(center - lastTrim) < 12) return;
        lastTrim = center;
        for(var i = 0; i < N; i++){
          if(i === 0 || i === stopIdx || i === center) continue;
          if(Math.abs(i - center) <= KEEP) continue;
          var im = imgs[i];
          if(!im || !im.complete) continue;
          im.onload = im.onerror = null;
          im.src = '';
          imgs[i] = null;
        }
      }

      function draw(im){
        var r = cv.getBoundingClientRect();
        var cw = r.width;
        var ch = r.height;
        var iw = im.naturalWidth;
        var ih = im.naturalHeight;
        if(!iw || !ih || !cw || !ch) return;
        var scale = Math.min(cw / iw, ch / ih);
        var dw = iw * scale;
        var dh = ih * scale;

        ctx.clearRect(0, 0, cw, ch);
        ctx.drawImage(im, (cw - dw) * 0.5, (ch - dh) * 0.5, dw, dh);
      }

      /* THE iOS FAILURE, and why the checks above cannot catch it.
         Under memory pressure iOS Safari purges an image's decoded bitmap but
         keeps the element: it still reports complete === true and
         naturalWidth === 1440. usable() therefore says yes, clearRect() wipes
         the canvas, and drawImage() then paints NOTHING — a blank section,
         with cur already advanced so no later scroll event repaints it. There
         is no synchronous way to detect this.
         decode() is the escape hatch: it resolves immediately for a live
         bitmap and forces a fresh decode for a purged one, so re-asserting it
         after painting repairs the frame out of band. A rejection means the
         frame is genuinely unusable, so drop it and let paint() re-fetch. */
      var verifiedFor = -1;
      function verify(idx, im){
        if(!im.decode || verifiedFor === idx) return;
        im.decode().then(function(){
          if(cur !== idx || verifiedFor === idx) return;
          verifiedFor = idx;
          draw(im);
        }, function(){
          if(imgs[idx] !== im) return;
          imgs[idx] = null;
          if(cur === idx){ cur = -1; paint(idx, true); }
        });
      }

      function paint(idx, force){
        if(idx === cur && !force) return;
        if(!usable(idx)){
          if(idx <= stopIdx) requestFrame(idx);
          var alt = nearestLoaded(idx);
          if(alt < 0) return;          // genuinely nothing decoded yet
          if(alt === cur && !force) return;
          idx = alt;                   // draw the closest frame we do have
        }
        var im = imgs[idx];
        cur = idx;
        draw(im);
        trim(idx);
        verify(idx, im);
      }

      function render(){
        pending = false;
        var p = reduce ? 1 : prog();
        paint(roastIndex(p), false);
        if(cap) cap.textContent = capFor(p);
      }

      function onScroll(){
        if(pending) return;
        pending = true;
        requestAnimationFrame(render);
      }

      function preload(){
        var budget = loadBudget();
        var step = frameStep();
        var queue = [];
        var seen = {};
        /* Only queue frames we can actually display: every Nth frame plus the
           final stop frame. Keeps mobile from fetching all 217. */
        function want(i){ return i >= 0 && i < budget && (i % step === 0 || i === stopIdx); }
        var priority = [0, stopIdx, Math.round(stopIdx * 0.5 / step) * step, step];
        priority.forEach(function(i){
          if(want(i) && !seen[i]){ seen[i] = true; queue.push(i); }
        });
        /* Reduced motion pins progress at 1, so only the final roasted frame is
           ever shown. Fetching the other ~54 would be pure waste — and on iOS
           it is the same memory pressure that blanks the canvas. */
        if(!reduce){
          for(var i = 0; i < budget; i++){
            if(want(i) && !seen[i]){ seen[i] = true; queue.push(i); }
          }
        } else {
          queue = [stopIdx];
        }
        targetLoads = queue.length;

        var active = 0;
        /* Clamp to what is actually queued, or a short queue (reduced motion
           queues a single frame) never reaches the threshold and the loader
           never clears. */
        var threshold = Math.min(readyThreshold(), targetLoads);

        function markDone(){
          done++;
          if(load) load.textContent = 'Loading ' + Math.min(100, Math.round(done / targetLoads * 100)) + '%';
          if(!ready && done >= threshold){
            ready = true;
            if(load) load.style.display = 'none';
            size();
            render();
          }
          if(done >= targetLoads && load) load.style.display = 'none';
        }

        function loadAt(i){
          if(imgs[i] || i >= N) return;
          active++;
          var im = new Image();
          var retried = false;
          im.decoding = 'async';
          function settle(){
            active--;
            markDone();
            pump();
          }
          im.onload = settle;
          im.onerror = function(){
            /* Retry at full res before counting this frame as done — bailing
               early would strand `active` and stall the queue. */
            if(!retried && im.src !== cfg.frames[i]){
              retried = true;
              smallOk = false;
              im.src = cfg.frames[i];
              return;
            }
            settle();
          };
          im.src = srcFor(i);
          imgs[i] = im;
        }

        function pump(){
          while(active < maxConcurrent() && queue.length){
            loadAt(queue.shift());
          }
        }

        pump();
      }

      var io = new IntersectionObserver(function(en){
        if(en[0].isIntersecting){ io.disconnect(); preload(); }
      }, { rootMargin: isCompact() ? '160px 0px' : '400px 0px' });
      io.observe(track);

      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', size);
      /* The stage is sized from --tcw-header-h, which the header script
         rewrites when it compacts. A custom-property change fires no resize
         event, so the CSS box shrank while the canvas backing store kept its
         old dimensions and the painted frame was left stretched. Observing the
         canvas catches that, and every other silent box change (font swap,
         orientation) with it. Writing cv.width/height does not alter the
         element's CSS box, so this cannot feed itself. */
      if(window.ResizeObserver){
        new ResizeObserver(function(){ size(); }).observe(cv);
      }
      if(window.visualViewport){
        window.visualViewport.addEventListener('resize', size);
        window.visualViewport.addEventListener('scroll', onScroll, { passive: true });
      }
      /* Reduced motion can be toggled mid-session (iOS Settings > Accessibility).
         The CSS side is already live via the media query; keep the JS in step so
         the stage doesn't stay pinned to a scrub position it no longer has. */
      function onReduceChange(){
        reduce = reduceMq.matches;
        size();
        render();
      }
      if(phoneMq.addEventListener){
        phoneMq.addEventListener('change', size);
        tabletMq.addEventListener('change', size);
        reduceMq.addEventListener('change', onReduceChange);
      } else if(phoneMq.addListener){
        phoneMq.addListener(size);
        tabletMq.addListener(size);
        reduceMq.addListener(onReduceChange);
      }
      size();
    };
  }

  if(document.readyState !== 'loading') window.__beanRoastClean(cfg);
  else document.addEventListener('DOMContentLoaded', function(){ window.__beanRoastClean(cfg); });
})();
</script>

{% schema %}
{
  "name": "Coffee Bean Roast",
  "tag": "section",
  "class": "section-coffee-bean-roast",
  "settings": [
    { "type": "header", "content": "Frames" },
    {
