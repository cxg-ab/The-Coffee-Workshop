<div class="site-container py-12 lg:py-16">
  <p class="section-eyebrow mb-4">{{ 'subscriptions.eyebrow' | t }}</p>
  <h1 class="section-title">{{ page.title | default: 'subscriptions.heading' | t }}</h1>

  <div class="prose-brand mx-auto mt-6 max-w-2xl text-center">
    <p>{{ section.settings.intro }}</p>
  </div>

  <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2" data-reveal-group>
    <div class="brand-card" data-reveal-item>
      <h2 class="text-lg font-bold uppercase tracking-[0.08em] text-ink">{{ 'subscriptions.single_title' | t }}</h2>
      <p class="prose-brand mt-4">{{ 'subscriptions.single_text' | t }}</p>
      <a href="/collections/beans" class="btn-outline mt-8 inline-flex">{{ 'subscriptions.cta' | t }}</a>
    </div>
    <div class="brand-card border-brand/30" data-reveal-item>
      <span class="section-eyebrow">{{ 'subscriptions.save' | t }}</span>
      <h2 class="mt-2 text-lg font-bold uppercase tracking-[0.08em] text-ink">{{ 'subscriptions.rotating_title' | t }}</h2>
      <p class="prose-brand mt-4">{{ 'subscriptions.rotating_text' | t }}</p>
      <a href="/collections/beans" class="btn-primary mt-8 inline-flex">{{ 'subscriptions.cta' | t }}</a>
    </div>
  </div>

  {%- if page.content != blank -%}
    <div class="prose-brand mx-auto mt-12 max-w-2xl">{{ page.content }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Subscriptions page",
  "tag": "section",
  "class": "subscriptions-section",
  "settings": [
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Fresh specialty coffee delivered on your schedule. Roasted in small batches in Ras Al Khaimah. Subscribe and save 10%."
    }
  ],
  "presets": [{ "name": "Subscriptions page" }]
}
{% endschema %}
