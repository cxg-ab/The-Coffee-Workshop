{%- liquid
  assign trust_speed = section.settings.marquee_speed | default: 40
  if section.settings.enable_marquee == false
    assign trust_marquee = false
  else
    assign trust_marquee = true
  endif
-%}

<section
  class="home-trust-bar{% if trust_marquee %} home-trust-bar--marquee{% endif %}{% if section.settings.pause_on_hover %} home-trust-bar--pause-hover{% endif %}"
  data-home-trust
  data-trust-marquee="{{ trust_marquee }}"
  data-trust-duration="{{ trust_speed }}"
  data-trust-pause-hover="{{ section.settings.pause_on_hover }}"
  aria-label="{{ section.settings.aria_label | default: 'Bean categories' }}"
>
  <div class="home-trust-bar__viewport">
    <div class="home-trust-bar__track" data-trust-track>
      <ul class="home-trust-bar__list" data-trust-set>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <li class="home-trust-bar__item" {{ block.shopify_attributes }}>
              <span class="home-trust-bar__dot" aria-hidden="true"></span>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="home-trust-bar__link">
                  {{- block.settings.label -}}
                </a>
              {%- else -%}
                <span class="home-trust-bar__text">{{ block.settings.label }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="home-trust-bar__item">
            <span class="home-trust-bar__dot" aria-hidden="true"></span>
            <span class="home-trust-bar__text">{{ 'header.single_origin' | t }}</span>
          </li>
          <li class="home-trust-bar__item">
            <span class="home-trust-bar__dot" aria-hidden="true"></span>
            <span class="home-trust-bar__text">{{ 'header.micro_lot' | t }}</span>
          </li>
          <li class="home-trust-bar__item">
            <span class="home-trust-bar__dot" aria-hidden="true"></span>
            <span class="home-trust-bar__text">{{ 'header.exotic' | t }}</span>
          </li>
          <li class="home-trust-bar__item">
            <span class="home-trust-bar__dot" aria-hidden="true"></span>
            <span class="home-trust-bar__text">{{ 'home.trust.capsules' | t }}</span>
          </li>
          <li class="home-trust-bar__item">
            <span class="home-trust-bar__dot" aria-hidden="true"></span>
            <span class="home-trust-bar__text">{{ 'home.trust.drip' | t }}</span>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home trust bar",
  "tag": "section",
  "class": "home-trust-bar-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Marquee"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Keep text moving",
      "default": true
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Scroll speed (seconds per loop)",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 40,
      "info": "Higher = slower"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Bean categories"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Name",
          "default": "Single Origin"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home trust bar",
      "blocks": [
        { "type": "item", "settings": { "label": "Single Origin" } },
        { "type": "item", "settings": { "label": "Micro-Lot" } },
        { "type": "item", "settings": { "label": "Exotic" } },
        { "type": "item", "settings": { "label": "Capsules" } },
        { "type": "item", "settings": { "label": "Drip" } }
      ]
    }
  ]
}
{% endschema %}
