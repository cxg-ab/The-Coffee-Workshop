{%- liquid
  assign is_home = false
  if template.name == 'index'
    assign is_home = true
  endif
  assign is_shop = false
  if template.name == 'collection'
    assign is_shop = true
  endif
-%}

{%- unless is_home -%}
  {%- if is_shop -%}
    {%- assign known_cats = 'single-origin,micro-lot,exotic,capsules-drip,accessories' | split: ',' -%}
    {%- assign is_aggregate = false -%}
    {%- unless known_cats contains collection.handle -%}{%- assign is_aggregate = true -%}{%- endunless -%}
    {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}

    <section
      class="shop-trust-bar"
      data-shop-trust
      data-aggregate="{% if is_aggregate %}true{% else %}false{% endif %}"
      aria-label="{{ section.settings.aria_label | default: 'Bean categories' }}"
    >
      <div class="shop-trust-bar__row">
        {%- if collection.products_count > 0 -%}
          <form class="plp-sort plp-sort--desktop" data-plp-sort>
            <label class="sr-only" for="plp-sort-select">{{ 'collections.sort' | t }}</label>
            <div class="plp-sort__control">
              <span class="plp-sort__prefix" aria-hidden="true">{{ 'collections.sort' | t }}</span>
              <select id="plp-sort-select" name="sort_by" class="plp-sort__select" aria-label="{{ 'collections.sort' | t }}">
                <option value="manual" {% if current_sort == 'manual' %}selected{% endif %}>{{ 'collections.sort_featured' | t }}</option>
                <option value="best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>{{ 'collections.sort_best_selling' | t }}</option>
                <option value="title-ascending" {% if current_sort == 'title-ascending' %}selected{% endif %}>{{ 'collections.sort_az' | t }}</option>
                <option value="title-descending" {% if current_sort == 'title-descending' %}selected{% endif %}>{{ 'collections.sort_za' | t }}</option>
                <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>{{ 'collections.sort_price_low' | t }}</option>
                <option value="price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>{{ 'collections.sort_price_high' | t }}</option>
                <option value="created-descending" {% if current_sort == 'created-descending' %}selected{% endif %}>{{ 'collections.sort_newest' | t }}</option>
                <option value="created-ascending" {% if current_sort == 'created-ascending' %}selected{% endif %}>{{ 'collections.sort_oldest' | t }}</option>
              </select>
              <svg class="plp-sort__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
            </div>
          </form>
        {%- endif -%}

        <button type="button" class="plp-tool-btn plp-filter-toggle" data-filter-toggle aria-expanded="false" aria-controls="plp-filter-panel" hidden>
          <svg class="plp-tool-btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h18M6 12h12M10 20h4" /></svg>
          <span class="plp-tool-btn__label">{{ 'collections.filter' | t }}</span>
          <span class="plp-filter-toggle__badge" data-filter-badge></span>
        </button>

        <div class="shop-trust-bar__pills-shell">
          <nav class="shop-trust-bar__pills" data-shop-pills aria-label="{{ section.settings.aria_label | default: 'Bean categories' }}">
            {%- if is_aggregate -%}
              <a href="{{ collection.url }}" class="shop-pill is-active" data-cat="all">{% if request.locale.iso_code == 'ar' %}الكل{% else %}All{% endif %}</a>
            {%- else -%}
              <a href="/collections/all-beans" class="shop-pill" data-cat="all">{% if request.locale.iso_code == 'ar' %}الكل{% else %}All{% endif %}</a>
            {%- endif -%}

            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign link_handle = block.settings.link | split: '/' | last | split: '?' | first | downcase
                  assign pill_active = false
                  if collection.handle == link_handle
                    assign pill_active = true
                  endif
                  assign cat_key = link_handle
                  if cat_key == blank
                    assign cat_key = block.settings.label | handleize
                  endif
                -%}
                <a
                  href="{{ block.settings.link | default: collection.url }}"
                  class="shop-pill{% if pill_active %} is-active{% endif %}"
                  data-cat="{{ cat_key }}"
                  {% if pill_active %}aria-current="page"{% endif %}
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.label -}}
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- for h in known_cats -%}
                {%- case h -%}
                  {%- when 'single-origin' -%}{%- assign cat_label = 'header.single_origin' | t -%}
                  {%- when 'micro-lot' -%}{%- assign cat_label = 'header.micro_lot' | t -%}
                  {%- when 'exotic' -%}{%- assign cat_label = 'header.exotic' | t -%}
                  {%- when 'capsules-drip' -%}{%- assign cat_label = 'header.capsules_drip' | t -%}
                  {%- when 'accessories' -%}{%- assign cat_label = 'header.accessories' | t -%}
                  {%- else -%}{%- assign cat_label = h -%}
                {%- endcase -%}
                <a href="/collections/{{ h }}" class="shop-pill{% if collection.handle == h %} is-active{% endif %}" data-cat="{{ h }}"{% if collection.handle == h %} aria-current="page"{% endif %}>{{ cat_label }}</a>
              {%- endfor -%}
            {%- endif -%}
          </nav>
        </div>

        {%- if collection.products_count > 0 -%}
          <div class="plp-sort plp-sort--mobile" data-plp-sort>
            <label class="sr-only" for="plp-sort-select-mobile">{{ 'collections.sort' | t }}</label>
            <div class="plp-tool-btn plp-sort__icon-hit">
              <svg class="plp-tool-btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h12M3 12h8M3 17h16" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 7l2 2 2-2M19 9v10" /></svg>
              <span class="plp-tool-btn__label">{{ 'collections.sort' | t }}</span>
              <select id="plp-sort-select-mobile" name="sort_by" class="plp-sort__select" aria-label="{{ 'collections.sort' | t }}">
                <option value="manual" {% if current_sort == 'manual' %}selected{% endif %}>{{ 'collections.sort_featured' | t }}</option>
                <option value="best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>{{ 'collections.sort_best_selling' | t }}</option>
                <option value="title-ascending" {% if current_sort == 'title-ascending' %}selected{% endif %}>{{ 'collections.sort_az' | t }}</option>
                <option value="title-descending" {% if current_sort == 'title-descending' %}selected{% endif %}>{{ 'collections.sort_za' | t }}</option>
                <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>{{ 'collections.sort_price_low' | t }}</option>
                <option value="price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>{{ 'collections.sort_price_high' | t }}</option>
                <option value="created-descending" {% if current_sort == 'created-descending' %}selected{% endif %}>{{ 'collections.sort_newest' | t }}</option>
                <option value="created-ascending" {% if current_sort == 'created-ascending' %}selected{% endif %}>{{ 'collections.sort_oldest' | t }}</option>
              </select>
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="plp-filter-backdrop" data-filter-backdrop hidden></div>
      <div class="plp-filter-panel" id="plp-filter-panel" data-filter-panel hidden>
        <div class="plp-filter-panel__grab" aria-hidden="true"></div>
        <p class="plp-filter-panel__title">{{ 'collections.filter' | t }}</p>
        <details class="plp-filter-group" data-filter-group="region" hidden>
          <summary class="plp-filter-group-title">{{ 'products.region' | t }}<svg class="plp-filter-group-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="plp-filter-options" data-filter-options="region"></div>
        </details>
        <details class="plp-filter-group" data-filter-group="process" hidden>
          <summary class="plp-filter-group-title">{{ 'products.process' | t }}<svg class="plp-filter-group-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="plp-filter-options" data-filter-options="process"></div>
        </details>
        <details class="plp-filter-group" data-filter-group="price" hidden>
          <summary class="plp-filter-group-title">{% if request.locale.iso_code == 'ar' %}نطاق السعر{% else %}Price Range{% endif %}<svg class="plp-filter-group-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="plp-filter-options" data-filter-options="price"></div>
        </details>
        <details class="plp-filter-group" data-filter-group="notes" hidden>
          <summary class="plp-filter-group-title">{{ 'products.flavor_notes' | t }}<svg class="plp-filter-group-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg></summary>
          <div class="plp-filter-options" data-filter-options="notes"></div>
        </details>
        <button type="button" class="plp-filter-clear" data-filter-clear hidden>{% if request.locale.iso_code == 'ar' %}مسح الكل{% else %}Clear all{% endif %}</button>
      </div>
    </section>

    <script>
      (function () {
        var nav = document.querySelector('[data-shop-pills]');
        if (!nav) return;
        var active = nav.querySelector('.shop-pill.is-active');
        if (!active) return;
        requestAnimationFrame(function () {
          /* Center the active pill by scrolling ONLY the pills strip — never
             scrollIntoView, which also scrolls the page horizontally and reveals
             a white gap on the right. */
          nav.scrollLeft = active.offsetLeft - (nav.clientWidth / 2) + (active.offsetWidth / 2);
        });
      })();
    </script>
  {%- else -%}
    <section
      class="home-trust-bar home-trust-bar--nav home-trust-bar--pills"
      data-home-trust
      data-trust-marquee="false"
      aria-label="{{ section.settings.aria_label | default: 'Bean categories' }}"
    >
      <div class="shop-trust-bar__pills-shell shop-trust-bar__pills-shell--alone">
        <nav class="home-trust-bar__pills-wrap shop-trust-bar__pills" data-shop-pills aria-label="{{ section.settings.aria_label | default: 'Bean categories' }}">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign item_active = false
                if block.settings.link != blank
                  assign link_handle = block.settings.link | split: '/' | last | split: '?' | first | downcase
                  if request.path contains link_handle and link_handle != blank
                    assign item_active = true
                  endif
                endif
              -%}
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="shop-pill{% if item_active %} is-active{% endif %}"
                {% if item_active %}aria-current="page"{% endif %}
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label -}}
              </a>
            {%- endfor -%}
          {%- else -%}
            <a href="/collections/single-origin" class="shop-pill">{{ 'header.single_origin' | t }}</a>
            <a href="/collections/micro-lot" class="shop-pill">{{ 'header.micro_lot' | t }}</a>
            <a href="/collections/exotic" class="shop-pill">{{ 'header.exotic' | t }}</a>
            <a href="/collections/capsules-drip" class="shop-pill">{{ 'header.capsules_drip' | t }}</a>
            <a href="/collections/accessories" class="shop-pill">{{ 'header.accessories' | t }}</a>
          {%- endif -%}
        </nav>
      </div>
    </section>
  {%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Home trust bar",
  "tag": "section",
  "class": "home-trust-bar-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Hidden on the homepage. Shop: mobile Filter | scroll pills | Sort. Desktop Sort | pills | Filter."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Bean categories"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Name",
          "default": "Single Origin"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home trust bar",
      "blocks": [
        { "type": "item", "settings": { "label": "Single Origin", "link": "/collections/single-origin" } },
        { "type": "item", "settings": { "label": "Micro-Lot", "link": "/collections/micro-lot" } },
        { "type": "item", "settings": { "label": "Exotic", "link": "/collections/exotic" } },
        { "type": "item", "settings": { "label": "Capsules & Drip", "link": "/collections/capsules-drip" } },
        { "type": "item", "settings": { "label": "Accessories", "link": "/collections/accessories" } }
      ]
    }
  ]
}
{% endschema %}
