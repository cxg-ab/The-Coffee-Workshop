<style>
  .origin-sticky-section {
    position: relative;
    background-color: #1C1917;
    color: #FFFFFF;
    padding: 6rem 0;
  }
  .origin-sticky-stage {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }
  @media (min-width: 1024px) {
    .origin-sticky-stage {
      grid-template-columns: 40% 1fr;
      gap: 6rem;
      align-items: start;
    }
  }
  .origin-sticky-intro {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 20;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .origin-sticky-intro::before {
    content: "";
    position: absolute;
    top: -10rem; /* Bleeds up behind the header */
    bottom: 0;
    left: -50vw;
    right: -50vw;
    background: #1C1917; /* Solid Onyx */
    z-index: -1;
  }
  .origin-sticky-intro::after {
    content: "";
    position: absolute;
    top: 100%;
    left: -50vw;
    right: -50vw;
    height: 4rem;
    background: linear-gradient(to bottom, #1C1917, transparent);
    z-index: -1;
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .origin-sticky-intro {
      top: 7rem;
      padding-top: 0;
      padding-bottom: 0;
    }
    .origin-sticky-intro::before,
    .origin-sticky-intro::after {
      display: none;
    }
  }
  .origin-sticky-heading {
    font-family: var(--font-display), system-ui, sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    margin: 1rem 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .origin-sticky-sub {
    font-size: 1.1rem;
    opacity: 0.8;
    max-width: 400px;
  }
  
  .origin-sticky-cards {
    display: flex;
    flex-direction: column;
    gap: 6rem;
    align-items: center;
  }
  .origin-sticky-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: 440px;
  }
  .origin-sticky-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 12px;
    overflow: hidden;
    background: #2A2624;
    box-shadow: 0 24px 48px rgba(0,0,0,0.4);
  }
  .origin-sticky-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .origin-sticky-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(107,143,82,0.1), rgba(139,94,60,0.15));
  }
  .origin-sticky-placeholder-text {
    font-family: var(--font-display), system-ui, sans-serif;
    font-size: 6rem;
    font-weight: bold;
    color: #C5A059;
    opacity: 0.2;
  }
  .origin-sticky-card__copy {
    display: flex;
    flex-direction: column;
  }
  .origin-sticky-card__name {
    font-family: var(--font-display), system-ui, sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0.5rem 0;
  }
  .origin-sticky-card__profile {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #C5A059;
    margin-bottom: 1rem;
  }
  .origin-sticky-card__note {
    font-size: 1rem;
    opacity: 0.75;
    line-height: 1.5;
  }
</style>

<section class="origin-sticky-section" data-origin-sticky-section>
  <div class="site-container origin-sticky-stage">
    
    <div class="origin-sticky-intro">
      <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="origin-sticky-heading">{{ section.settings.heading }}</h2>
      <p class="origin-sticky-sub prose-brand">{{ section.settings.subheading }}</p>
    </div>

    <div class="origin-sticky-cards">
      {%- for block in section.blocks -%}
        <article class="origin-sticky-card" {{ block.shopify_attributes }}>
          <div class="origin-sticky-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'origin-sticky-card__img',
                  loading: 'lazy',
                  alt: block.settings.name
              }}
            {%- else -%}
              <div class="origin-sticky-card__placeholder">
                <span class="origin-sticky-placeholder-text">{{ block.settings.name | slice: 0, 2 | upcase }}</span>
              </div>
            {%- endif -%}
          </div>
          <div class="origin-sticky-card__copy">
            <p class="origin-sticky-card__meta section-eyebrow">( {{ block.settings.region }} )</p>
            <h3 class="origin-sticky-card__name">{{ block.settings.name }}</h3>
            {%- if block.settings.profile != blank -%}
              <p class="origin-sticky-card__profile">{{ block.settings.profile }}</p>
            {%- endif -%}
            {%- if block.settings.note != blank -%}
              <p class="origin-sticky-card__note">{{ block.settings.note }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Origin sticky split",
  "tag": "section",
  "class": "origin-sticky-split-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Micro-lot origins"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One origin at a time"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We discover, sample, and reserve green Arabica from micro-lots worldwide — each origin roasted to express its character."
    }
  ],
  "blocks": [
    {
      "type": "origin",
      "name": "Origin",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Country",
          "default": "Ethiopia"
        },
        {
          "type": "text",
          "id": "region",
          "label": "Region label",
          "default": "African highlands"
        },
        {
          "type": "text",
          "id": "profile",
          "label": "Flavor profile",
          "default": "Floral · Citrus · Tea-like"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Story note",
          "default": "Bright, expressive washed lots from Yirgacheffe and Guji — among the first origins we cup each season."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Origin image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Origin sticky split",
      "blocks": [
        {
          "type": "origin",
          "settings": {
            "name": "Ethiopia",
            "region": "African highlands",
            "profile": "Floral · Citrus · Tea-like",
            "note": "Bright washed lots from Yirgacheffe and Guji — expressive and clean in the cup."
          }
        },
        {
          "type": "origin",
          "settings": {
            "name": "Panama",
            "region": "Central America",
            "profile": "Jasmine · Bergamot · Honey",
            "note": "Geisha and prized micro-lots from Boquete — reserved in small quantities each harvest."
          }
        },
        {
          "type": "origin",
          "settings": {
            "name": "Yemen",
            "region": "Arabian Peninsula",
            "profile": "Dried fruit · Spice · Complex",
            "note": "Ancient terroir, traditional drying — among the most sought-after lots we source."
          }
        },
        {
          "type": "origin",
          "settings": {
            "name": "Colombia",
            "region": "South America",
            "profile": "Caramel · Red apple · Balanced",
            "note": "Small-farm Colombia Huila lots — versatile and sweet, roasted for everyday brewers."
          }
        },
        {
          "type": "origin",
          "settings": {
            "name": "Kenya",
            "region": "East Africa",
            "profile": "Blackcurrant · Tomato · Bright",
            "note": "AA-grade Kenyan auctions — vibrant acidity with a syrupy body when roasted medium."
          }
        }
      ]
    }
  ]
}
{% endschema %}
