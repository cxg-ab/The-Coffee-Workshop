<style>
  /* Editor-only "please complete" banner for an origin item linked to a
     product that is missing some display info. Never shown to customers. */
  .origin-sticky-card__warn {
    margin: 0 0 0.6rem;
    padding: 0.45rem 0.65rem;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.35;
    color: #8a5a00;
    background: #fff7e6;
    border: 1px solid #f0d38a;
    border-radius: 4px;
  }
</style>

<section class="origin-sticky-section" data-origin-sticky-section>
  {%- assign origin_total = section.blocks.size | prepend: '0' | slice: -2, 2 -%}

  <div class="site-container origin-sticky-stage">
    <div class="origin-sticky-intro">
      <p class="section-eyebrow origin-sticky-eyebrow" data-reveal data-reveal-y="24" data-reveal-scale="1">{{ section.settings.eyebrow }}</p>
      <h2 class="origin-sticky-heading" data-split-title>{{ section.settings.heading }}</h2>
      <p class="origin-sticky-sub prose-brand" data-reveal data-reveal-y="28" data-reveal-scale="1" data-reveal-delay="0.15">{{ section.settings.subheading }}</p>

      {%- if section.blocks.size > 0 -%}
        <p class="origin-sticky-progress" aria-live="polite">
          <span class="origin-sticky-progress__label">{{ 'home.origin.progress' | t }}</span>
          <span class="origin-sticky-progress__count">
            <span data-origin-progress-current>01</span><span aria-hidden="true">/</span><span data-origin-progress-total>{{ origin_total }}</span>
          </span>
        </p>
      {%- endif -%}
    </div>

    <div class="origin-sticky-cards">
      {%- for block in section.blocks -%}
        {%- comment -%}
          Option 1 (product picked): copy the card from the product's PDP data —
          name, region, flavour notes, image, description — and link the card to
          the product page. Anything the product is missing falls back to the
          Option 2 field, so the admin can fill the gap. In the theme editor a
          warning lists whatever is still empty (soft "mandatory" — Shopify can't
          hard-block Save on section fields).
          Option 2 (no product): the manual fields are used as-is.
        {%- endcomment -%}
        {%- assign origin_product = block.settings.product -%}
        {%- assign origin_url = blank -%}
        {%- comment -%} Start from the manual fields; the product overrides each one it can supply. {%- endcomment -%}
        {%- assign origin_name = block.settings.name -%}
        {%- assign origin_region = block.settings.region -%}
        {%- assign origin_profile = block.settings.profile -%}
        {%- assign origin_note = block.settings.note -%}
        {%- assign origin_image = block.settings.image -%}

        {%- if origin_product != blank -%}
          {%- assign origin_url = origin_product.url -%}
          {%- assign origin_name = origin_product.title -%}
          {%- if origin_product.metafields.coffee.region.value != blank -%}
            {%- assign origin_region = origin_product.metafields.coffee.region.value -%}
          {%- elsif origin_product.metafields.coffee.country.value != blank -%}
            {%- assign origin_region = origin_product.metafields.coffee.country.value -%}
          {%- endif -%}
          {%- if origin_product.metafields.coffee.flavor_notes.value != blank -%}
            {%- assign origin_profile = origin_product.metafields.coffee.flavor_notes.value | join: ' · ' -%}
          {%- endif -%}
          {%- if origin_product.description != blank -%}
            {%- assign origin_note = origin_product.description | strip_html | truncate: 140 -%}
          {%- endif -%}
          {%- if origin_product.featured_media != blank -%}
            {%- assign origin_image = origin_product.featured_media.preview_image -%}
          {%- endif -%}
        {%- endif -%}

        {%- comment -%} Editor-only completeness check: flag anything still missing. {%- endcomment -%}
        {%- assign origin_missing = '' -%}
        {%- if origin_product != blank -%}
          {%- if origin_region == blank -%}{%- assign origin_missing = origin_missing | append: '|Region' -%}{%- endif -%}
          {%- if origin_profile == blank -%}{%- assign origin_missing = origin_missing | append: '|Flavour profile' -%}{%- endif -%}
          {%- if origin_image == blank -%}{%- assign origin_missing = origin_missing | append: '|Image' -%}{%- endif -%}
          {%- if origin_note == blank -%}{%- assign origin_missing = origin_missing | append: '|Story note' -%}{%- endif -%}
          {%- assign origin_missing = origin_missing | remove_first: '|' | replace: '|', ', ' -%}
        {%- endif -%}

        <article class="origin-sticky-card" data-origin-card data-origin-index="{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="origin-sticky-card__media" data-origin-media>
            {%- if origin_image != blank -%}
              {%- if origin_url != blank -%}
                <a href="{{ origin_url }}" class="origin-sticky-card__media-link">
                  {{
                    origin_image
                    | image_url: width: 800
                    | image_tag:
                      class: 'origin-sticky-card__img',
                      loading: 'lazy',
                      widths: '280, 400, 560, 800',
                      sizes: '(min-width: 1024px) 280px, min(72vw, 300px)',
                      alt: origin_name
                  }}
                </a>
              {%- else -%}
                {{
                  origin_image
                  | image_url: width: 800
                  | image_tag:
                    class: 'origin-sticky-card__img',
                    loading: 'lazy',
                    widths: '280, 400, 560, 800',
                    sizes: '(min-width: 1024px) 280px, min(72vw, 300px)',
                    alt: origin_name
                }}
              {%- endif -%}
            {%- else -%}
              <div class="origin-sticky-card__placeholder">
                <span class="origin-sticky-placeholder-text">{{ origin_name | slice: 0, 2 | upcase }}</span>
              </div>
            {%- endif -%}
          </div>
          <div class="origin-sticky-card__copy" data-origin-copy>
            {%- if request.design_mode and origin_missing != blank -%}
              <p class="origin-sticky-card__warn">⚠ Complete this item before publishing — missing: {{ origin_missing }}. Add it on the product “{{ origin_product.title }}” (Product page → Details) or type it in Option 2 below.</p>
            {%- endif -%}
            {%- if origin_region != blank -%}
              <p class="origin-sticky-card__meta section-eyebrow">( {{ origin_region }} )</p>
            {%- endif -%}
            <h3 class="origin-sticky-card__name" data-split-title>
              {%- if origin_url != blank -%}
                <a href="{{ origin_url }}" class="origin-sticky-card__name-link">{{ origin_name }}</a>
              {%- else -%}
                {{ origin_name }}
              {%- endif -%}
            </h3>
            {%- if origin_profile != blank -%}
              <p class="origin-sticky-card__profile">{{ origin_profile }}</p>
            {%- endif -%}
            {%- if origin_note != blank -%}
              <p class="origin-sticky-card__note">{{ origin_note }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>

  <div class="origin-section-transition" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "Origin sticky split",
  "tag": "section",
  "class": "origin-sticky-split-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Micro-lot origins" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One origin at a time" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "We discover, sample, and reserve green Arabica from micro-lots worldwide — each origin roasted to express its character." }
  ],
  "blocks": [
    {
      "type": "origin",
      "name": "Origin item",
      "settings": [
        { "type": "paragraph", "content": "Pick a product (Option 1) and the card copies its product-page details — name, region, flavour notes, image, description — and links to that product. Anything the product is missing, fill in Option 2. The editor shows a warning on any card that is still incomplete. Leave the product empty to use Option 2 on its own." },
        { "type": "header", "content": "Option 1 — Pick from your products" },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Copies name, region, flavour profile, image and description from the product, and links the card to its page."
        },
        { "type": "header", "content": "Option 2 — Details (fills anything the product is missing)" },
        { "type": "text", "id": "name", "label": "Display name" },
        { "type": "text", "id": "region", "label": "Region label" },
        { "type": "text", "id": "profile", "label": "Flavour profile" },
        { "type": "textarea", "id": "note", "label": "Story note" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Origin sticky split",
      "blocks": [
        { "type": "origin", "settings": { "name": "Ethiopia", "region": "African highlands", "profile": "Floral · Citrus · Tea-like", "note": "Bright washed lots from Yirgacheffe and Guji — expressive and clean in the cup." }},
        { "type": "origin", "settings": { "name": "Panama", "region": "Central America", "profile": "Jasmine · Bergamot · Honey", "note": "Geisha and prized micro-lots from Boquete — reserved in small quantities each harvest." }},
        { "type": "origin", "settings": { "name": "Yemen", "region": "Arabian Peninsula", "profile": "Dried fruit · Spice · Complex", "note": "Ancient terroir, traditional drying — among the most sought-after lots we source." }},
        { "type": "origin", "settings": { "name": "Colombia", "region": "South America", "profile": "Caramel · Red apple · Balanced", "note": "Small-farm Colombia Huila lots — versatile and sweet, roasted for everyday brewers." }},
        { "type": "origin", "settings": { "name": "Kenya", "region": "East Africa", "profile": "Blackcurrant · Tomato · Bright", "note": "AA-grade Kenyan auctions — vibrant acidity with a syrupy body when roasted medium." }}
      ]
    }
  ]
}
{% endschema %}
