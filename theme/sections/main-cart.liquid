<div class="site-container py-12 lg:py-16">
  <h1 class="section-title mb-10" data-reveal data-reveal-y="32" data-reveal-scale="1">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="mx-auto max-w-lg py-16 text-center">
      <p class="text-muted">{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-primary mt-8 inline-flex">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  {%- else -%}
    <div class="mb-8 border border-line bg-white px-6 py-4 text-sm text-muted">
      {{ 'cart.flat_shipping_note' | t }}
    </div>

    <form action="{{ routes.cart_url }}" method="post" id="cart-form">
      <div class="border border-line bg-white">

        <!-- Desktop / tablet: table layout (sm and up).
             Mobile table rows don't reflow — three columns of padding
             (image+title, qty, price) add up to ~540px minimum, wider
             than most phones, and the wrapper previously used
             overflow-hidden, which clipped content rather than scrolling
             it. Below sm, we now render a stacked card list instead
             (same pattern the cart drawer already uses). -->
        <table class="hidden w-full text-sm sm:table">
          <thead class="border-b border-line bg-canvas">
            <tr>
              <th class="px-6 py-4 text-start font-semibold uppercase tracking-[0.12em] text-muted" colspan="2">Product</th>
              <th class="px-6 py-4 text-start font-semibold uppercase tracking-[0.12em] text-muted">Qty</th>
              <th class="px-6 py-4 text-end font-semibold uppercase tracking-[0.12em] text-muted">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {%- for item in cart.items -%}
              <tr>
                <td class="px-6 py-6" colspan="2">
                  <div class="flex gap-4">
                    {%- if item.image -%}
                      <a href="{{ item.url }}" class="shrink-0">
                        {{ item.image | image_url: width: 160 | image_tag: class: 'h-24 w-24 object-cover', loading: 'lazy' }}
                      </a>
                    {%- endif -%}
                    <div>
                      <a href="{{ item.url }}" class="font-medium text-ink hover:text-brand">{{ item.product.title }}</a>
                      {%- unless item.variant.title == 'Default Title' -%}
                        <p class="mt-1 text-xs text-muted">{{ item.variant.title }}</p>
                      {%- endunless -%}
                    </div>
                  </div>
                </td>
                <td class="px-6 py-6">
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    class="w-20 border border-line px-3 py-2 text-center"
                    aria-label="Quantity for {{ item.product.title }}"
                  >
                </td>
                <td class="px-6 py-6 text-end font-semibold text-brand">
                  {{ item.final_line_price | money }}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <!-- Mobile: stacked card list (below sm) -->
        <ul class="divide-y divide-line sm:hidden">
          {%- for item in cart.items -%}
            <li class="flex gap-4 p-4">
              {%- if item.image -%}
                <a href="{{ item.url }}" class="shrink-0">
                  {{ item.image | image_url: width: 160 | image_tag: class: 'h-20 w-20 object-cover', loading: 'lazy' }}
                </a>
              {%- endif -%}
              <div class="min-w-0 flex-1">
                <a href="{{ item.url }}" class="block font-medium text-ink hover:text-brand">{{ item.product.title }}</a>
                {%- unless item.variant.title == 'Default Title' -%}
                  <p class="mt-1 text-xs text-muted">{{ item.variant.title }}</p>
                {%- endunless -%}
                <div class="mt-3 flex items-center justify-between gap-3">
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    class="w-16 border border-line px-2 py-2 text-center text-sm"
                    aria-label="Quantity for {{ item.product.title }}"
                  >
                  <span class="font-semibold text-brand">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

      </div>

      <div class="mt-8 flex flex-col items-stretch gap-4 sm:flex-row sm:items-end sm:justify-between">
        <button type="submit" name="update" class="btn-outline">
          Update cart
        </button>
        <div class="w-full max-w-sm border border-line bg-white p-6 sm:w-auto">
          <div class="flex items-center justify-between">
            <span class="text-sm uppercase tracking-[0.12em] text-muted">{{ 'cart.subtotal' | t }}</span>
            <span class="text-xl font-semibold text-ink">{{ cart.total_price | money }}</span>
          </div>
          <button type="submit" name="checkout" class="btn-primary mt-6 w-full">
            {{ 'cart.checkout' | t }}
          </button>
        </div>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": []
}
{% endschema %}
