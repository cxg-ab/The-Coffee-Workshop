{%- comment -%} Reset customer password — TCW themed. {%- endcomment -%}
{% render 'account-styles' %}

<div class="acct">
  <div class="site-container">
    <div class="acct-auth">
      <header class="acct-head" style="text-align:center;">
        <p class="acct-head__eyebrow">{{ 'customer.account.eyebrow' | t }}</p>
        <h1 class="acct-head__title">{{ 'customer.reset.title' | t }}</h1>
        <p class="acct-head__sub">{{ 'customer.reset.text' | t }}</p>
      </header>

      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <div class="acct-alert acct-alert--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="acct-form">
          <div class="acct-field">
            <label class="acct-label" for="reset_password">{{ 'customer.reset.password' | t }}</label>
            <input type="password" name="customer[password]" id="reset_password" class="acct-input" autocomplete="new-password" required>
          </div>
          <div class="acct-field">
            <label class="acct-label" for="reset_password_confirmation">{{ 'customer.reset.confirm' | t }}</label>
            <input type="password" name="customer[password_confirmation]" id="reset_password_confirmation" class="acct-input" autocomplete="new-password" required>
          </div>
          <button type="submit" class="btn-primary acct-btn-full">{{ 'customer.reset.submit' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>
