<style>
  /* Paint-safe hidden state for the cart drawer.
     We do NOT rely on the [hidden] attribute here: Tailwind's `.flex`
     utility is compiled after [hidden]{display:none} with equal specificity,
     so `.flex` wins and [hidden] is ignored. Using visibility + transform
     keeps the panel completely unpainted until it is opened, which removes
     the white-panel flash that appeared on the right during page load. */
  .cart-drawer {
    visibility: hidden;
    transform: translateX(100%);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                visibility 0s linear 0.5s;
    will-change: transform;
  }
  [dir="rtl"] .cart-drawer { transform: translateX(-100%); }
  .cart-drawer.is-open {
    visibility: visible;
    transform: translateX(0);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                visibility 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-drawer { transition: none; }
  }

  /* Cart-drawer line quantity + remove controls */
  .cart-line--busy { opacity: 0.45; pointer-events: none; }
  .cd-qty { display: inline-flex; align-items: center; border: 1px solid var(--color-line, #E8E4DC); border-radius: 999px; overflow: hidden; background: #FFFFFF; }
  .cd-qty__btn { width: 1.9rem; height: 1.9rem; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 0; cursor: pointer; font-size: 0.95rem; line-height: 1; color: var(--color-ink, #1A1A1A); transition: background-color 0.2s ease, color 0.2s ease; }
  .cd-qty__btn:hover { background: var(--color-brand, #8B5E3C); color: #FFFFFF; }
  .cd-qty__btn:disabled { opacity: 0.4; cursor: default; }
  .cd-qty__input { width: 2rem; height: 1.9rem; border: 0; text-align: center; font-size: 0.8rem; background: transparent; color: var(--color-ink, #1A1A1A); -moz-appearance: textfield; }
  .cd-qty__input::-webkit-outer-spin-button, .cd-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .cd-remove { display: inline-flex; align-items: center; justify-content: center; width: 1.9rem; height: 1.9rem; background: none; border: 0; cursor: pointer; color: var(--color-muted, #6B6B6B); transition: color 0.2s ease; }
  .cd-remove:hover { color: #A32D2D; }
  .cd-remove svg { width: 0.9rem; height: 0.9rem; }
</style>

<div
  class="pointer-events-none fixed inset-0 z-[60] bg-ink/40 opacity-0 transition-opacity duration-300"
  data-cart-overlay
  aria-hidden="true"
></div>

<aside
  class="cart-drawer fixed inset-y-0 z-[70] flex w-full max-w-md flex-col bg-white shadow-2xl ltr:right-0 rtl:left-0"
  data-cart-drawer
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'cart.title' | t }}"
>
  <div class="flex items-center justify-between border-b border-line px-6 py-5">
    <h2 class="font-display text-lg font-bold uppercase tracking-[0.1em]">
      {{ 'cart.title' | t }}
      <span class="text-muted" data-cart-drawer-count>({{ cart.item_count }})</span>
    </h2>
    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center text-ink transition-colors hover:text-brand"
      data-cart-close
      aria-label="{{ 'accessibility.close' | t }}"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="border-b border-line bg-canvas px-6 py-3 text-xs text-muted">
      {{ 'cart.flat_shipping_note' | t }}
    </div>
  {%- endif -%}

  <div class="flex-1 overflow-y-auto px-6 py-4" data-cart-drawer-items>
    {%- if cart.item_count == 0 -%}
      <p class="py-12 text-center text-sm text-muted">{{ 'cart.empty' | t }}</p>
    {%- else -%}
      <ul class="divide-y divide-line">
        {%- for item in cart.items -%}
          <li class="flex gap-4 py-4" data-cart-line-item="{{ item.key }}">
            <a href="{{ item.url }}" class="tcw-product-media tcw-product-media--thumb shrink-0">
              {%- if item.image -%}
                {{
                  item.image
                  | image_url: width: 200
                  | image_tag: class: 'tcw-product-media__img', loading: 'lazy', alt: item.product.title
                }}
              {%- else -%}
                <img src="{{ 'product-placeholder.webp' | asset_url }}" class="tcw-product-media__img" style="object-fit:cover" loading="lazy" alt="{{ item.product.title | escape }}">
              {%- endif -%}
            </a>
            <div class="min-w-0 flex-1">
              <a href="{{ item.url }}" class="block text-sm font-medium text-ink hover:text-brand">
                {{ item.product.title }}
              </a>
              {%- unless item.variant.title == 'Default Title' -%}
                <p class="mt-1 text-xs text-muted">{{ item.variant.title }}</p>
              {%- endunless -%}
              <div class="mt-2 flex items-center justify-between gap-2">
                <span class="text-sm font-semibold text-brand" data-line-price>{{ item.final_line_price | money }}</span>
                <div class="flex items-center gap-1.5">
                  <div class="cd-qty" data-qty>
                    <button type="button" class="cd-qty__btn" data-qty-minus aria-label="{{ 'cart.decrease_quantity' | t: product: item.product.title }}">&minus;</button>
                    <input class="cd-qty__input" data-qty-input type="number" inputmode="numeric" min="0" value="{{ item.quantity }}" aria-label="{{ 'cart.quantity_for' | t: product: item.product.title }}">
                    <button type="button" class="cd-qty__btn" data-qty-plus aria-label="{{ 'cart.increase_quantity' | t: product: item.product.title }}">+</button>
                  </div>
                  <button type="button" class="cd-remove" data-line-remove aria-label="{{ 'cart.remove_item' | t: product: item.product.title }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
                  </button>
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="border-t border-line px-6 py-5">
    <div class="mb-4 flex items-center justify-between">
      <span class="text-sm uppercase tracking-[0.12em] text-muted">{{ 'cart.subtotal' | t }}</span>
      <span class="text-lg font-semibold text-ink" data-cart-subtotal>{{ cart.total_price | money }}</span>
    </div>
    <div class="flex flex-col gap-3">
      <a href="{{ routes.cart_url }}" class="btn-outline w-full text-center">
        {{ 'cart.view_cart' | t }}
      </a>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn-primary w-full"{% if cart.item_count == 0 %} disabled{% endif %}>
          {{ 'cart.checkout' | t }}
        </button>
      </form>
    </div>
  </div>
</aside>
