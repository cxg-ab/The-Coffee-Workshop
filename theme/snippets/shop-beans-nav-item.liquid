{%- liquid
  assign parent_label = parent_title | default: 'header.shop_beans' | t
-%}
<li class="tcw-dropdown-trigger relative" data-mobile-dropdown>
  <div class="flex items-center justify-between">
    <!-- Pure dropdown toggle, not a navigational link — "Shop Bean" itself
         has no destination page, it only opens the list of collections
         below. Works the same at every screen size (mobile and desktop
         both rely on this one button + JS toggle, not CSS-forced-visible). -->
    <button
      type="button"
      class="{{ link_class }} flex items-center gap-1 justify-start whitespace-nowrap"
      data-mobile-dropdown-toggle
      aria-haspopup="true"
      aria-expanded="false"
    >
      {{ parent_label }}
      <svg class="w-3 h-3 opacity-50 tcw-dropdown-icon transition-transform duration-300" data-mobile-dropdown-icon fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
  </div>
  <ul class="tcw-dropdown-menu hidden flex-col pl-4 mt-2 space-y-2 lg:pl-0 lg:mt-0 lg:space-y-0" data-mobile-dropdown-menu>
    <li class="tcw-dropdown-item" style="transition-delay: 50ms;">
      <a href="/collections/single-origin" class="group relative flex items-center justify-between px-2 py-2 lg:px-6 lg:py-3.5 text-[12px] font-bold tracking-[0.15em] uppercase text-[#1C1917]/80 lg:text-[#1C1917]/70 transition-all duration-300 hover:text-[#C5A059] lg:rounded-lg overflow-hidden">
        <span class="absolute inset-0 w-0 bg-gradient-to-r from-[#C5A059]/10 to-transparent transition-all duration-500 ease-out group-hover:w-full rounded-lg z-0"></span>
        <span class="relative z-10 transition-transform duration-300 lg:group-hover:translate-x-2 lg:group-hover:scale-105 origin-left">{{ 'header.single_origin' | t }}</span>
        <svg class="w-5 h-5 opacity-0 -translate-x-4 transition-all duration-500 group-hover:opacity-100 group-hover:translate-x-0 text-[#C5A059] hidden lg:block relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </li>
    <li class="tcw-dropdown-item" style="transition-delay: 100ms;">
      <a href="/collections/micro-lot" class="group relative flex items-center justify-between px-2 py-2 lg:px-6 lg:py-3.5 text-[12px] font-bold tracking-[0.15em] uppercase text-[#1C1917]/80 lg:text-[#1C1917]/70 transition-all duration-300 hover:text-[#C5A059] lg:rounded-lg overflow-hidden">
        <span class="absolute inset-0 w-0 bg-gradient-to-r from-[#C5A059]/10 to-transparent transition-all duration-500 ease-out group-hover:w-full rounded-lg z-0"></span>
        <span class="relative z-10 transition-transform duration-300 lg:group-hover:translate-x-2 lg:group-hover:scale-105 origin-left">{{ 'header.micro_lot' | t }}</span>
        <svg class="w-5 h-5 opacity-0 -translate-x-4 transition-all duration-500 group-hover:opacity-100 group-hover:translate-x-0 text-[#C5A059] hidden lg:block relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </li>
    <li class="tcw-dropdown-item" style="transition-delay: 150ms;">
      <a href="/collections/exotic" class="group relative flex items-center justify-between px-2 py-2 lg:px-6 lg:py-3.5 text-[12px] font-bold tracking-[0.15em] uppercase text-[#1C1917]/80 lg:text-[#1C1917]/70 transition-all duration-300 hover:text-[#C5A059] lg:rounded-lg overflow-hidden">
        <span class="absolute inset-0 w-0 bg-gradient-to-r from-[#C5A059]/10 to-transparent transition-all duration-500 ease-out group-hover:w-full rounded-lg z-0"></span>
        <span class="relative z-10 transition-transform duration-300 lg:group-hover:translate-x-2 lg:group-hover:scale-105 origin-left">{{ 'header.exotic' | t }}</span>
        <svg class="w-5 h-5 opacity-0 -translate-x-4 transition-all duration-500 group-hover:opacity-100 group-hover:translate-x-0 text-[#C5A059] hidden lg:block relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </li>
    <li class="tcw-dropdown-item" style="transition-delay: 200ms;">
      <a href="/collections/capsules-drip" class="group relative flex items-center justify-between px-2 py-2 lg:px-6 lg:py-3.5 text-[12px] font-bold tracking-[0.15em] uppercase text-[#1C1917]/80 lg:text-[#1C1917]/70 transition-all duration-300 hover:text-[#C5A059] lg:rounded-lg overflow-hidden">
        <span class="absolute inset-0 w-0 bg-gradient-to-r from-[#C5A059]/10 to-transparent transition-all duration-500 ease-out group-hover:w-full rounded-lg z-0"></span>
        <span class="relative z-10 transition-transform duration-300 lg:group-hover:translate-x-2 lg:group-hover:scale-105 origin-left">{{ 'header.capsules_drip' | t }}</span>
        <svg class="w-5 h-5 opacity-0 -translate-x-4 transition-all duration-500 group-hover:opacity-100 group-hover:translate-x-0 text-[#C5A059] hidden lg:block relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </li>
  </ul>
</li>
