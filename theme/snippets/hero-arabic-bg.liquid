{%- comment -%}
  Decorative Arabic word field. Words shuffle into fixed slots (session-stable) via application.js.
{%- endcomment -%}
<div
  class="hero-arabic-bg"
  data-hero-arabic-bg
  data-hero-arabic-words="قهوه,بن,مختص,محمصة,حبوب,تحميص,دفعات,اسبريسو,كابتشينو,تقطير,محصول,إيحاءات,طبيعي,مغسول,محمص,إمارات"
  aria-hidden="true"
>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-1"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-2"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-3"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-4"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-5"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-6"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-7"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-8"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-9"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-10"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-11"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-12"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-13"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-14"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-15"></span>
  <span class="hero-arabic-bg__word hero-arabic-bg__word--slot-16"></span>
</div>
