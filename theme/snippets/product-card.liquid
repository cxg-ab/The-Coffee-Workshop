{%- liquid
  assign product_url = card_product.url
  assign featured_image = card_product.featured_media.preview_image
  assign is_limited = card_product.metafields.coffee.is_limited.value
-%}

<article class="product-card group relative flex flex-col overflow-hidden rounded-xl border border-white/5 bg-[#1C1917] transition-all duration-500 hover:-translate-y-1 hover:border-brand/30 hover:shadow-[0_8px_30px_rgba(197,160,89,0.15)]">
  <a href="{{ product_url }}" class="relative block overflow-hidden bg-black/40 aspect-square">
    {%- if featured_image -%}
      <div class="absolute inset-0 bg-gradient-to-t from-[#1C1917] via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 z-10 pointer-events-none"></div>
      {{
        featured_image
        | image_url: width: 600
        | image_tag:
          class: 'product-card__image h-full w-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90 group-hover:opacity-100',
          loading: 'lazy',
          widths: '300, 400, 600',
          sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw',
          alt: card_product.featured_media.alt | default: card_product.title
      }}
    {%- else -%}
      <div class="flex h-full w-full items-center justify-center text-xs uppercase tracking-[0.2em] text-white/30">
        No Image
      </div>
    {%- endif -%}

    {%- if is_limited or card_product.available == false -%}
      <div class="absolute left-4 top-4 flex flex-col gap-2 z-20">
        {%- if is_limited -%}
          <span class="inline-flex items-center justify-center rounded-sm bg-brand px-3 py-1 text-[9px] font-bold uppercase tracking-[0.2em] text-[#1C1917] backdrop-blur-md">
            Limited Batch
          </span>
        {%- endif -%}
        {%- unless card_product.available -%}
          <span class="inline-flex items-center justify-center rounded-sm bg-black/80 px-3 py-1 text-[9px] font-bold uppercase tracking-[0.2em] text-white backdrop-blur-md border border-white/10">
            Sold Out
          </span>
        {%- endunless -%}
      </div>
    {%- endif -%}
    
    <!-- Quick Add Button Overlay -->
    {%- if card_product.available -%}
      <div class="absolute bottom-4 left-4 right-4 z-20 translate-y-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100 hidden lg:block">
        <form method="post" action="{{ routes.cart_add_url }}">
          <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
          <button type="submit" class="w-full rounded-md bg-brand/90 backdrop-blur-md py-3 text-[10px] font-bold uppercase tracking-[0.2em] text-[#1C1917] transition-colors hover:bg-brand">
            Quick Add
          </button>
        </form>
      </div>
    {%- endif -%}
  </a>

  <div class="flex flex-1 flex-col p-6 z-10">
    <a href="{{ product_url }}" class="text-lg font-bold tracking-wide text-white transition-colors group-hover:text-brand">
      {{ card_product.title }}
    </a>

    {%- if card_product.metafields.coffee.flavor_notes.value != blank -%}
      <p class="mt-3 text-xs font-light leading-relaxed text-white/60 line-clamp-2">
        {{ card_product.metafields.coffee.flavor_notes.value | join: ' &bull; ' }}
      </p>
    {%- else -%}
      <p class="mt-3 text-[11px] uppercase tracking-widest text-brand/70 font-semibold">
        Signature Roast
      </p>
    {%- endif -%}

    <div class="mt-auto flex items-center justify-between pt-6">
      <span class="text-sm font-bold tracking-wider text-brand">
        {%- if card_product.price_varies -%}
          From {{ card_product.price_min | money }}
        {%- else -%}
          {{ card_product.price | money }}
        {%- endif -%}
      </span>

      <!-- Mobile Add to Cart Icon -->
      {%- if card_product.available -%}
        <form method="post" action="{{ routes.cart_add_url }}" class="lg:hidden">
          <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
          <button type="submit" class="flex h-8 w-8 items-center justify-center rounded-full bg-brand/10 text-brand transition-colors hover:bg-brand hover:text-[#1C1917]">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </button>
        </form>
      {%- endif -%}
    </div>
  </div>
</article>
