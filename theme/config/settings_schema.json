[
  {
    "name": "theme_info",
    "theme_name": "The Coffee Workshop",
    "theme_version": "1.1.0",
    "theme_author": "The Coffee Workshop Co.",
    "theme_documentation_url": "https://www.thecoffeeworkshop.ae",
    "theme_support_url": "https://www.thecoffeeworkshop.ae"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 280,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 180
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Tagline",
        "default": "Specialty Coffee"
      },
      {
        "type": "text",
        "id": "brand_established",
        "label": "Established year",
        "default": "2018"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_brand",
        "label": "Brand bronze",
        "default": "#8B5E3C"
      },
      {
        "type": "color",
        "id": "color_brand_dark",
        "label": "Brand dark (hover)",
        "default": "#6B4428"
      },
      {
        "type": "color",
        "id": "color_brand_light",
        "label": "Brand light (highlights)",
        "default": "#C9A962"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#FAFAF8"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / cards",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted text",
        "default": "#6B6B6B"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders",
        "default": "#E8E4DC"
      }
    ]
  },
  {
    "name": "Contact",
    "settings": [
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Phone",
        "default": "+971 7 222 4466"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Email",
        "default": "info@thecoffeeworkshop.ae"
      },
      {
        "type": "text",
        "id": "contact_website",
        "label": "Website",
        "default": "www.thecoffeeworkshop.ae"
      },
      {
        "type": "textarea",
        "id": "contact_address",
        "label": "Address",
        "default": "Al Nahdah St, Dafan Al Khor, Ras Al Khaimah, United Arab Emirates"
      },
      {
        "type": "text",
        "id": "maps_url",
        "label": "Google Maps URL",
        "default": "https://maps.google.com/?q=Al+Nahdah+St+Dafan+Al+Khor+Ras+Al+Khaimah"
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "Enable GSAP scroll animations",
        "default": true
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL",
        "info": "Full link, e.g. https://facebook.com/thecoffeeworkshop"
      }
    ]
  }
]
